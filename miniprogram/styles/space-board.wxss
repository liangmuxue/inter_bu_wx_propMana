/* 共享空间 · 预约看板（参考员工端小程序2 space-home） */

.space-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f6f8;
  box-sizing: border-box;
}

.space-scope-hint {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: #fff;
  border-bottom: 1rpx solid var(--color-border);
}

.space-query-panel {
  flex-shrink: 0;
  margin: 20rpx 28rpx 0;
  padding: 24rpx;
  border: 1rpx solid rgba(26, 95, 219, 0.35);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(26, 95, 219, 0.06);
}

.space-search {
  margin-bottom: 20rpx;
}

.space-search-input {
  width: 100%;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #f1f4f8;
  font-size: 26rpx;
  color: var(--color-text);
  box-sizing: border-box;
}

.space-calendar {
  border-top: 1rpx solid rgba(26, 95, 219, 0.12);
  padding-top: 20rpx;
}

.space-month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.space-month-shift {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 16rpx;
  background: rgba(26, 95, 219, 0.08);
  color: var(--color-primary);
  font-size: 36rpx;
}

.space-month-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.space-home-calendar-main {
  display: flex;
  align-items: center;
  gap: 4rpx;
  min-width: 0;
}

.space-home-date-nav {
  flex-shrink: 0;
  width: 56rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  color: #64748b;
  font-size: 40rpx;
}

.space-home-date-nav:active {
  color: var(--color-primary);
}

.space-home-date-strip {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.space-home-date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 84rpx;
  padding: 4rpx 0 8rpx;
  vertical-align: top;
}

.space-home-weekday {
  font-size: 20rpx;
  color: #94a3b8;
  line-height: 1.2;
}

.space-home-day {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
}

.space-home-date-item.active .space-home-weekday {
  color: var(--color-primary);
  font-weight: 600;
}

.space-home-date-item.active .space-home-day {
  background: var(--color-primary);
  color: #fff;
}

.space-home-date-item.is-today:not(.active) .space-home-day {
  box-shadow: inset 0 0 0 2rpx rgba(26, 95, 219, 0.35);
}

.space-list-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 20rpx;
}

.space-room-list {
  padding: 0 28rpx 28rpx;
}

.space-room-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.space-room-card.is-disabled {
  opacity: 0.72;
}

.space-room-top {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.space-room-main {
  flex: 1;
  min-width: 0;
}

.space-room-title-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.space-room-name {
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.space-room-status {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.space-room-status.is-success {
  background: rgba(47, 155, 106, 0.12);
  color: var(--color-success);
}

.space-room-status.is-warning {
  background: rgba(245, 158, 11, 0.14);
  color: #b45309;
}

.space-room-status.is-danger {
  background: rgba(229, 62, 62, 0.12);
  color: var(--color-danger);
}

.space-room-status.is-muted {
  background: rgba(100, 116, 139, 0.12);
  color: #64748b;
}

.space-room-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.space-room-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: #eef2f7;
}

.space-facilities {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #64748b;
}

.space-slot-board {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
}

.space-slot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 0;
}

.space-slot {
  min-width: 72rpx;
  min-height: 60rpx;
  padding: 8rpx 4rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  font-size: 22rpx;
  text-align: center;
  background: #fff;
  color: var(--color-text-secondary);
  box-sizing: border-box;
}

.space-slot-grid.is-compact .space-slot {
  position: relative;
  z-index: 0;
  min-width: 72rpx;
  min-height: 48rpx;
  padding: 4rpx 0;
  border: none;
  border-radius: 0;
  background: transparent;
  color: var(--color-text);
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.space-slot.is-booked {
  background: #c9d4e4;
  color: #334155;
}

.space-slot-grid.is-compact .space-slot.is-booked {
  background: transparent;
  color: #334155;
  font-weight: 600;
}

.space-slot-grid.is-compact .space-slot.is-booked::before {
  content: '';
  position: absolute;
  top: 2rpx;
  bottom: 2rpx;
  left: 0;
  right: 0;
  z-index: -1;
  background: #c9d4e4;
  pointer-events: none;
}

.space-slot-grid.is-compact .space-slot.is-booked.is-run-start::before {
  border-radius: 12rpx 0 0 12rpx;
}

.space-slot-grid.is-compact .space-slot.is-booked.is-run-mid::before {
  border-radius: 0;
}

.space-slot-grid.is-compact .space-slot.is-booked.is-run-end::before {
  border-radius: 0 12rpx 12rpx 0;
}

.space-slot-grid.is-compact .space-slot.is-booked.is-run-single::before {
  border-radius: 12rpx;
}

.space-slot.is-blocked {
  background: #f8fafc;
  color: #94a3b8;
  box-shadow: inset 0 0 0 1rpx rgba(148, 163, 184, 0.45);
  background-image: repeating-linear-gradient(
    -45deg,
    rgba(248, 250, 252, 1) 0,
    rgba(248, 250, 252, 1) 8rpx,
    rgba(226, 232, 240, 0.85) 8rpx,
    rgba(226, 232, 240, 0.85) 16rpx
  );
}

.space-slot-grid.is-compact .space-slot.is-blocked {
  background: #f8fafc;
  color: #94a3b8;
  box-shadow: inset 0 0 0 1rpx rgba(148, 163, 184, 0.45);
  background-image: repeating-linear-gradient(
    -45deg,
    rgba(248, 250, 252, 1) 0,
    rgba(248, 250, 252, 1) 8rpx,
    rgba(226, 232, 240, 0.85) 8rpx,
    rgba(226, 232, 240, 0.85) 16rpx
  );
}

.space-slot-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.space-legend {
  display: flex;
  gap: 16rpx;
}

.space-legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.space-legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}

.space-legend-dot.is-available {
  background: #fff;
  border: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.space-legend-dot.is-booked {
  background: #c9d4e4;
}

.space-legend-dot.is-blocked {
  background: #f8fafc;
  border: 1rpx dashed #94a3b8;
  box-sizing: border-box;
  background-image: repeating-linear-gradient(
    -45deg,
    rgba(248, 250, 252, 1) 0,
    rgba(248, 250, 252, 1) 4rpx,
    rgba(226, 232, 240, 0.9) 4rpx,
    rgba(226, 232, 240, 0.9) 8rpx
  );
}

.space-empty {
  padding: 80rpx 0;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.space-slot.is-cleaning {
  background: #eef2f7;
  color: #5c6b80;
}

.space-legend-dot.is-cleaning {
  background: #d5deea;
}
