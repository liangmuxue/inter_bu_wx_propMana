/* 共享空间 · 预约记录卡片 / 详情（对齐员工端小程序2 我的预约） */

.space-booking-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.space-booking-card {
  overflow: hidden;
  padding: 0;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.04);
}

.space-booking-card.is-info {
  border-left: 6rpx solid #3182ce;
}

.space-booking-card.is-success {
  border-left: 6rpx solid #38a169;
}

.space-booking-card.is-muted {
  border-left: 6rpx solid #94a3b8;
}

.space-booking-card.is-warning {
  border-left: 6rpx solid #dd6b20;
}

.space-booking-card-main {
  padding: 28rpx 28rpx 24rpx;
}

.space-booking-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.space-booking-card-when {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.space-booking-card-when .when-date {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.3;
}

.space-booking-card-when .when-time {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.space-booking-card-head .status-tag {
  flex-shrink: 0;
  min-height: 48rpx;
  padding: 0 20rpx;
  line-height: 48rpx;
}

.space-booking-card-subject {
  display: block;
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.35;
}

.space-booking-card-room {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.space-booking-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 4rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
}

.space-booking-card-code {
  font-size: 22rpx;
  color: var(--color-text-light, #a0aec0);
  font-variant-numeric: tabular-nums;
}

.space-booking-card-go {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f1f5f9;
  color: var(--color-text-light, #a0aec0);
  font-size: 24rpx;
  line-height: 1;
}

/* 预约详情 */
.space-booking-detail-page {
  min-height: 100vh;
  padding: 0 28rpx 48rpx;
  background: #f3f6fb;
  box-sizing: border-box;
}

.space-booking-detail-hero {
  position: relative;
  overflow: visible;
  margin-top: 8rpx;
  padding: 32rpx;
  border-radius: 36rpx;
  background: #fff;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 16rpx 48rpx rgba(15, 23, 42, 0.05);
}

.space-booking-detail-hero::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(26, 95, 219, 0.08);
  transform: translate(-36%, -42%);
  pointer-events: none;
  z-index: 0;
}

.space-booking-detail-hero.is-success::before {
  background: rgba(47, 158, 68, 0.1);
}

.space-booking-detail-hero.is-warning::before {
  background: rgba(245, 159, 0, 0.12);
}

.space-booking-detail-hero.is-muted::before {
  background: rgba(100, 116, 139, 0.1);
}

.space-booking-detail-hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.space-booking-detail-hero-top .status-tag {
  min-height: 48rpx;
  padding: 0 20rpx;
  line-height: 48rpx;
}

.space-booking-detail-code {
  font-size: 22rpx;
  color: var(--color-text-light, #a0aec0);
  font-variant-numeric: tabular-nums;
}

.space-booking-detail-subject {
  position: relative;
  z-index: 1;
  display: block;
  margin-bottom: 12rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.3;
  color: var(--color-text);
}

.space-booking-detail-room {
  position: relative;
  z-index: 1;
  display: block;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.space-booking-detail-facilities {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.space-facility-tag {
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--color-border);
  font-size: 22rpx;
  color: var(--color-text-secondary);
  background: #fafbfc;
}

.space-booking-detail-when {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.space-booking-detail-when .when-block {
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #f5f8fc;
  border: 1rpx solid rgba(15, 23, 42, 0.04);
}

.space-booking-detail-when .when-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-light, #a0aec0);
}

.space-booking-detail-when .when-value {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.space-booking-detail-card {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.03);
}

.space-booking-detail-card .detail-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.detail-row {
  display: grid;
  grid-template-columns: 176rpx 1fr;
  align-items: start;
  gap: 24rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
}

.detail-row:first-child {
  border-top: none;
  padding-top: 8rpx;
}

.detail-dt {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-text-light, #a0aec0);
}

.detail-dd {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
  color: var(--color-text);
  word-break: break-word;
}

.detail-dd .status-tag {
  display: inline-flex;
  vertical-align: top;
}
