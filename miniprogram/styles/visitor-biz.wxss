/* 访客业务列表通用样式（预约 / 邀约 / 列表） */
.page {
  height: 100vh;
  width: 100%;
  max-width: 100vw;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-bg);
  box-sizing: border-box;
}

.scope-bar {
  flex-shrink: 0;
  width: 100%;
  min-width: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--color-border);
  align-items: center;
  box-sizing: border-box;
}

.scope-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  background: #F7FAFC;
  border-radius: var(--radius);
  line-height: 1.2;
}

.scope-item.active {
  color: var(--color-primary);
  background: #EBF4FF;
  font-weight: 600;
}

.scope-action {
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  font-size: 26rpx;
  color: #fff;
  background: var(--color-primary);
  border-radius: var(--radius);
  font-weight: 600;
}

.filter-trigger {
  flex-shrink: 0;
  position: relative;
  padding: 12rpx 20rpx;
  margin: 12rpx 24rpx 12rpx 0;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: #F7FAFC;
  border-radius: var(--radius);
}

.filter-trigger.active {
  color: var(--color-primary);
  background: #EBF4FF;
  font-weight: 600;
}

.filter-dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E53E3E;
}

.filter-bar-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  background: #fff;
  border-bottom: 1rpx solid var(--color-border);
}

.filter-bar {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.filter-inner {
  display: inline-flex;
  padding: 12rpx 24rpx 12rpx 24rpx;
  gap: 12rpx;
  align-items: center;
}

.filter-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: #F7FAFC;
  border-radius: 999rpx;
}

.filter-item.active {
  color: #fff;
  background: var(--color-primary);
  font-weight: 600;
}

.filter-tail {
  width: 80rpx;
  flex-shrink: 0;
}

.query-summary {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: #F7FAFC;
  border-bottom: 1rpx solid var(--color-border);
}

.query-reset {
  color: var(--color-primary);
}

.hint-bar {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
  background: #F7FAFC;
}

.list-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.item-card {
  margin-bottom: 20rpx;
}

.void-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.void-entry-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.void-entry-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-danger);
}

.void-entry-sub {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.void-entry-go {
  flex-shrink: 0;
  font-size: 36rpx;
  color: var(--color-text-secondary);
  line-height: 1;
}

.item-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.item-heading {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.biz-chip {
  display: inline-block;
  align-self: flex-start;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  color: var(--color-primary);
  background: #EBF4FF;
  border-radius: 8rpx;
}

.item-id {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  word-break: break-all;
}

.kv-row {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.kv-label {
  flex-shrink: 0;
  width: 140rpx;
  color: var(--color-text-secondary);
}

.kv-value {
  flex: 1;
  color: var(--color-text);
  word-break: break-all;
}

.filter-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.filter-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.filter-panel-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.filter-panel-title {
  font-size: 30rpx;
  font-weight: 600;
}

.filter-panel-close {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.filter-field {
  margin-bottom: 24rpx;
}

.filter-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.filter-input-wrap {
  background: #F7FAFC;
  border-radius: var(--radius);
  overflow: hidden;
}

.filter-input {
  display: block;
  width: 100%;
  min-height: 80rpx;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.filter-input-placeholder {
  color: #A0AEC0;
}

.filter-actions {
  display: flex;
  gap: 16rpx;
}

.btn-reset,
.btn-query {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
  line-height: 2.2;
  border-radius: var(--radius);
}

.btn-reset {
  color: var(--color-text);
  background: #EDF2F7;
}

.btn-query {
  color: #fff;
  background: var(--color-primary);
}

.btn-reset::after,
.btn-query::after {
  border: none;
}

.action-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 120;
  display: flex;
  align-items: flex-end;
}

.action-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 8rpx 0 calc(16rpx + env(safe-area-inset-bottom));
}

.action-sheet-item {
  padding: 28rpx 32rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--color-text);
  border-bottom: 1rpx solid var(--color-border);
}

.action-sheet-item small {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.action-sheet-cancel {
  margin-top: 12rpx;
  border-bottom: none;
  color: var(--color-text-secondary);
}
