.page {
  height: 100vh;
  width: 100%;
  max-width: 100vw;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-bg);
  box-sizing: border-box;
}

.scope-bar {
  flex-shrink: 0;
  width: 100%;
  min-width: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--color-border);
  align-items: center;
  box-sizing: border-box;
}

.scope-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  background: #F7FAFC;
  border-radius: var(--radius);
  line-height: 1.2;
}

.scope-item.active {
  color: var(--color-primary);
  background: #EBF4FF;
  font-weight: 600;
}

.filter-trigger {
  flex-shrink: 0;
  position: relative;
  min-width: 96rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: #F7FAFC;
  border-radius: var(--radius);
  box-sizing: border-box;
}

.filter-icon {
  white-space: nowrap;
  line-height: 1.2;
}

.filter-trigger.active {
  color: var(--color-primary);
  background: #EBF4FF;
  font-weight: 600;
}

.filter-dot {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E53E3E;
}

.filter-bar-wrap {
  flex-shrink: 0;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  background: #fff;
  border-bottom: 1rpx solid var(--color-border);
  box-sizing: border-box;
  overflow: hidden;
}

.filter-bar {
  width: 100%;
  height: 88rpx;
  white-space: nowrap;
}

.filter-inner {
  display: inline-block;
  padding: 16rpx 0 16rpx 24rpx;
  white-space: nowrap;
  height: 88rpx;
  box-sizing: border-box;
}

.filter-item {
  display: inline-block;
  vertical-align: middle;
  margin-right: 16rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: #F7FAFC;
  border-radius: 999rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.filter-item.active {
  color: #fff;
  background: var(--color-primary);
  font-weight: 600;
}

.filter-tail {
  display: inline-block;
  width: 24rpx;
  height: 1rpx;
  vertical-align: middle;
}

.query-summary {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: #F7FAFC;
  border-bottom: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.query-summary-text {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.4;
}

.query-reset {
  flex-shrink: 0;
  white-space: nowrap;
  color: var(--color-primary);
}

.list-scroll {
  flex: 1;
  height: 0;
}

.container {
  padding: 24rpx 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.item-card {
  margin-bottom: 20rpx;
}

.item-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.item-code {
  font-size: 28rpx;
  font-weight: 600;
}

.kv-row {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.kv-label {
  flex-shrink: 0;
  width: 160rpx;
  color: var(--color-text-secondary);
}

.kv-value {
  flex: 1;
  color: var(--color-text);
  word-break: break-all;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.filter-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.45);
}

.filter-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.action-btn {
  flex: 1;
  min-width: 140rpx;
  margin: 0;
  padding: 0;
  font-size: 26rpx;
  line-height: 2.2;
  color: var(--color-primary);
  background: #EBF4FF;
  border-radius: var(--radius);
  border: none;
}

.action-btn::after {
  border: none;
}
