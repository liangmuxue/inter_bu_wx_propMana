@import "../../../styles/space-board.wxss";
@import "../../../styles/space-booking.wxss";
@import "../../../styles/workorder-list.wxss";

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-bg);
}

.space-records-search-wrap {
  flex-shrink: 0;
  padding: 20rpx 28rpx 12rpx;
  background: #fff;
}

.space-records-search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.space-records-search-wrap .space-search-input {
  flex: 1;
  min-width: 0;
  margin: 0;
}

.space-date-filter-btn {
  position: relative;
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #f1f4f8;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.space-date-filter-btn-hover {
  opacity: 0.85;
}

.space-date-filter-btn.is-active {
  background: #ebf4ff;
}

.space-date-filter-icon {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  flex-direction: column;
}

.space-date-filter-icon .cal-top {
  height: 10rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: #64748b;
}

.space-date-filter-btn.is-active .space-date-filter-icon .cal-top {
  background: var(--color-primary, #1a5fdb);
}

.space-date-filter-icon .cal-body {
  flex: 1;
  margin-top: 2rpx;
  padding: 6rpx 5rpx 4rpx;
  border-radius: 0 0 6rpx 6rpx;
  border: 2rpx solid #64748b;
  border-top: none;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rpx;
}

.space-date-filter-btn.is-active .space-date-filter-icon .cal-body {
  border-color: var(--color-primary, #1a5fdb);
}

.space-date-filter-icon .cal-dot {
  height: 6rpx;
  border-radius: 2rpx;
  background: #94a3b8;
}

.space-date-filter-btn.is-active .space-date-filter-icon .cal-dot {
  background: var(--color-primary, #1a5fdb);
}

.space-date-filter-dot {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e53e3e;
}

.space-date-filter-panel {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: max-height 0.28s ease, opacity 0.22s ease, margin-top 0.28s ease;
  margin-top: 0;
}

.space-date-filter-panel.is-open {
  max-height: 320rpx;
  opacity: 1;
  margin-top: 16rpx;
}

.space-date-filter-inner {
  padding: 20rpx 4rpx 4rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
}

.space-date-filter-fields {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
}

.space-date-filter-field {
  flex: 1;
  min-width: 0;
}

.space-date-filter-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.3;
}

.space-date-filter-value {
  height: 68rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #f1f4f8;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 68rpx;
  box-sizing: border-box;
}

.space-date-filter-value.is-placeholder {
  font-weight: 400;
  color: #94a3b8;
}

.space-date-filter-sep {
  flex-shrink: 0;
  padding-bottom: 18rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.space-date-filter-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.space-date-filter-actions button {
  flex: 1;
  margin: 0;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.space-date-filter-actions button::after {
  border: none;
}

.space-date-filter-reset {
  background: #f1f4f8 !important;
  color: #475569 !important;
}

.space-date-filter-apply {
  background: var(--color-primary, #1a5fdb) !important;
  color: #fff !important;
}

.filter-bar-wrap.is-status-only .filter-bar {
  width: 100%;
}

.filter-bar-wrap.is-status-only .filter-inner {
  padding-right: 24rpx;
}

.list-scroll {
  flex: 1;
  min-height: 0;
}

.container.space-booking-list {
  padding-top: 8rpx;
}

/* 物业端：突出会议室与时间，弱化主题 */
.space-booking-card.is-property .when-date {
  font-size: 30rpx;
}

.space-booking-card.is-property .when-time {
  font-size: 28rpx;
  font-weight: 700;
}

.space-booking-card.is-property .space-booking-card-room {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.35;
}

.space-booking-card.is-property .space-booking-card-booker {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.space-booking-card.is-property .space-booking-card-booker .booker-org {
  color: #94a3b8;
}

.space-booking-card.is-property .space-booking-card-subject {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #94a3b8;
  line-height: 1.4;
}
