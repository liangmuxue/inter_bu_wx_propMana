@import "../../../styles/space-board.wxss";
@import "../../../styles/space-booking.wxss";

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-bg);
}

.space-fee-filter {
  flex-shrink: 0;
  padding: 20rpx 24rpx 16rpx;
  background: #fff;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.06);
}

.space-fee-view-tabs {
  display: flex;
  gap: 6rpx;
  margin-bottom: 18rpx;
  padding: 6rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
}

.space-fee-view-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.2;
}

.space-fee-view-tab.is-active {
  background: #fff;
  color: #1a5fdb;
  font-weight: 650;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.08);
}

.space-fee-filter-card {
  padding: 16rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 1rpx solid #eef2f7;
}

.space-fee-date-range {
  display: flex;
  align-items: center;
  gap: 0;
  margin-bottom: 14rpx;
  padding: 4rpx;
  border-radius: 14rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  box-sizing: border-box;
}

.space-fee-date-picker-wrap {
  flex: 1;
  min-width: 0;
  width: 0;
}

.space-fee-date-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 18rpx 12rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #334155;
  line-height: 1.2;
}

.space-fee-date-picker.is-placeholder {
  color: #94a3b8;
}

.space-fee-date-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.space-fee-date-icon {
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid #1a5fdb;
  border-radius: 4rpx;
  position: relative;
  flex-shrink: 0;
  box-sizing: border-box;
  opacity: 0.9;
}
.space-fee-date-icon::before {
  content: '';
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  top: -4rpx;
  height: 4rpx;
  background: #1a5fdb;
  border-radius: 2rpx;
}

.space-fee-filter-sep {
  flex-shrink: 0;
  width: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1;
}

.space-fee-filter-grid {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.space-fee-filter-cell {
  flex: 1;
  min-width: 0;
  width: 0;
  position: relative;
}

.space-fee-filter-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 68rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  font-size: 24rpx;
  color: #334155;
  line-height: 1.2;
}

.space-fee-filter-chip-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.space-fee-filter-caret {
  flex-shrink: 0;
  color: #94a3b8;
  font-size: 20rpx;
  line-height: 1;
}

.space-fee-status-multi {
  z-index: 3;
}

.space-fee-status-trigger.is-open {
  border-color: rgba(26, 95, 219, 0.45);
  box-shadow: 0 0 0 4rpx rgba(26, 95, 219, 0.08);
}

.space-fee-status-panel {
  position: absolute;
  top: calc(100% + 8rpx);
  left: 0;
  right: 0;
  min-width: 100%;
  padding: 8rpx;
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 10rpx 32rpx rgba(15, 23, 42, 0.14);
  border: 1rpx solid #e2e8f0;
}

.space-fee-status-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 12rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #334155;
}

.space-fee-status-option:active {
  background: #f1f5f9;
}

.space-fee-status-option checkbox {
  transform: scale(0.78);
}

.space-fee-filter-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 4rpx;
}

.space-fee-filter-tip {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.3;
}

.space-fee-reset {
  flex-shrink: 0;
  padding: 8rpx 4rpx 8rpx 16rpx;
  font-size: 24rpx;
  color: #1a5fdb;
  font-weight: 550;
}

.space-fee-summary {
  flex-shrink: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  padding: 16rpx 28rpx 8rpx;
  background: #fff;
}

.space-fee-period-hint {
  flex-shrink: 0;
  padding: 0 28rpx 16rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
  background: #fff;
}

.space-fee-org-period {
  display: block;
  margin: 0 0 12rpx;
  font-size: 22rpx;
  color: #64748b;
}

.space-fee-summary-card {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.space-fee-summary-card .label {
  font-size: 22rpx;
  color: #64748b;
}

.space-fee-summary-card .value {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.space-fee-summary-card.is-total {
  background: rgba(26, 95, 219, 0.08);
}

.space-fee-summary-card.is-total .value {
  color: #1a5fdb;
}

.space-fee-list-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.space-fee-card-rows {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
}

.space-fee-card-rows .is-total {
  color: #1a5fdb;
  font-weight: 650;
}

.space-booking-card-fee {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 650;
  color: #1a5fdb;
}

.space-fee-org-list {
  padding-bottom: 24rpx;
}

.space-fee-org-card {
  margin: 0 24rpx 16rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.space-fee-org-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.space-fee-org-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.space-fee-org-count {
  font-size: 22rpx;
  color: #64748b;
}
