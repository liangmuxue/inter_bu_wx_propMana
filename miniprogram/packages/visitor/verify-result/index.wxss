.page {
  min-height: 100vh;
  background: var(--color-bg);
  box-sizing: border-box;
}

.hint-text {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.scan-stage {
  height: 280rpx;
  border-radius: var(--radius);
  background: #1A2332;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.scan-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}

.scan-tip {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
}

.error-text {
  display: block;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--color-danger);
  line-height: 1.4;
}

.submit-btn {
  width: 100%;
  margin: 0;
}
