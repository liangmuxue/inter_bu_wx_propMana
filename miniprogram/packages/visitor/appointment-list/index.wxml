<view class="page">
  <view class="scope-bar">
    <view class="scope-item {{tab === 'org' ? 'active' : ''}}" bindtap="onTabChange" data-tab="org">组织预约</view>
    <view class="scope-item {{tab === 'mine' ? 'active' : ''}}" bindtap="onTabChange" data-tab="mine">我的审批</view>
    <view class="filter-trigger {{queryActive ? 'active' : ''}}" bindtap="openFilterPanel">
      <text>筛选</text>
      <text wx:if="{{queryActive}}" class="filter-dot"></text>
    </view>
  </view>

  <view class="filter-bar-wrap">
    <scroll-view scroll-x class="filter-bar" show-scrollbar="{{false}}">
      <view class="filter-inner">
        <view
          wx:for="{{statusFilters}}"
          wx:key="id"
          class="filter-item {{status === item.id ? 'active' : ''}}"
          bindtap="onStatusChange"
          data-id="{{item.id}}"
        >{{item.label}}</view>
        <view class="filter-tail"></view>
      </view>
    </scroll-view>
  </view>

  <view class="query-summary" wx:if="{{queryActive}}">
    <text>已启用查询筛选</text>
    <text class="query-reset" bindtap="resetQuery">清除</text>
  </view>

  <view class="hint-bar">
    <text wx:if="{{tab === 'org'}}">展示组织数据权限内被访组织的访客预约记录。</text>
    <text wx:else>仅展示本人作为审批人的访客预约。</text>
  </view>

  <scroll-view
    class="list-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="container">
      <view
        wx:for="{{list}}"
        wx:key="id"
        class="card item-card"
        bindtap="onOpenDetail"
        data-id="{{item.id}}"
      >
        <view class="item-head">
          <view class="item-heading">
            <text class="biz-chip">{{item.bizLabel}}</text>
            <text class="item-id">{{item.id}}</text>
          </view>
          <text class="status-tag {{item.flowStatusClass}}">{{item.flowStatus}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">访客</text>
          <text class="kv-value">{{item.visitorName}} · {{item.visitorMobileMasked}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">访问开始</text>
          <text class="kv-value">{{item.visitStartText}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">访问结束</text>
          <text class="kv-value">{{item.visitEndText}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">被访组织</text>
          <text class="kv-value">{{item.visitDepartmentName}}</text>
        </view>
        <view class="kv-row" wx:if="{{item.showHostPerson}}">
          <text class="kv-label">被访人</text>
          <text class="kv-value">{{item.hostName}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">同行人数</text>
          <text class="kv-value">{{item.companionCount}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">来访事由</text>
          <text class="kv-value">{{item.reasonText}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">预约时间</text>
          <text class="kv-value">{{item.createdAt || '—'}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">审批人</text>
          <text class="kv-value">{{item.approver || '—'}}</text>
        </view>
      </view>

      <view wx:if="{{!loading && !list.length}}" class="empty">{{tab === 'mine' ? '暂无我的审批' : '暂无访客预约'}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{showFilterPanel}}" class="filter-mask" bindtap="closeFilterPanel" catchtouchmove="preventClose">
    <view class="filter-panel" catchtap="preventClose" catchtouchmove="preventClose">
      <view class="filter-panel-hd">
        <text class="filter-panel-title">查询条件</text>
        <text class="filter-panel-close" bindtap="closeFilterPanel">关闭</text>
      </view>
      <view class="filter-field">
        <text class="filter-label">关键词</text>
        <view class="filter-input-wrap">
          <input
            class="filter-input"
            placeholder="单号、访客、被访组织"
            placeholder-class="filter-input-placeholder"
            value="{{queryForm.keyword}}"
            bindinput="onQueryKeywordInput"
            confirm-type="search"
            bindconfirm="applyQuery"
          />
        </view>
      </view>
      <view class="filter-actions">
        <button class="btn-reset" bindtap="resetQuery">重置</button>
        <button class="btn-query" bindtap="applyQuery">查询</button>
      </view>
    </view>
  </view>
</view>
