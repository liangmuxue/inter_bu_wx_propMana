<view class="page">
  <view class="filter-bar-wrap">
    <scroll-view scroll-x class="filter-bar" show-scrollbar="{{false}}">
      <view class="filter-inner">
        <view
          wx:for="{{resultFilters}}"
          wx:key="id"
          class="filter-item {{result === item.id ? 'active' : ''}}"
          bindtap="onResultChange"
          data-result="{{item.id}}"
        >{{item.label}}</view>
        <view class="filter-tail"></view>
      </view>
    </scroll-view>
    <view class="filter-trigger {{queryActive ? 'active' : ''}}" bindtap="openFilterPanel">
      <text>筛选</text>
      <text wx:if="{{queryActive}}" class="filter-dot"></text>
    </view>
  </view>

  <view class="query-summary" wx:if="{{queryActive}}">
    <text>已启用查询筛选</text>
    <text class="query-reset" bindtap="resetQuery">清除</text>
  </view>

  <view class="hint-bar">
    <text>按被访组织数据权限过滤。</text>
  </view>

  <scroll-view
    class="list-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="container">
      <view wx:for="{{list}}" wx:key="id" class="card item-card">
        <view class="item-head">
          <text class="item-code">{{item.name}}</text>
          <text class="tag {{item.resultClass}}">{{item.result}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">通行时间</text>
          <text class="kv-value">{{item.time}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">手机号</text>
          <text class="kv-value">{{item.phone}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">关联单据</text>
          <text
            class="kv-value {{item.order !== '—' ? 'link' : ''}}"
            catchtap="onOpenOrder"
            data-order="{{item.order}}"
          >{{item.order}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">业务</text>
          <text class="kv-value">{{item.biz}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">被访组织</text>
          <text class="kv-value">{{item.dept}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">权限组</text>
          <text class="kv-value">{{item.groupName}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">设备</text>
          <text class="kv-value">{{item.device}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">核验方式</text>
          <text class="kv-value">{{item.method}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">方向</text>
          <text class="kv-value">{{item.dir}}</text>
        </view>
      </view>

      <view wx:if="{{!loading && !list.length}}" class="empty">暂无通行记录</view>
    </view>
  </scroll-view>

  <view wx:if="{{showFilterPanel}}" class="filter-mask" bindtap="closeFilterPanel" catchtouchmove="preventClose">
    <view class="filter-panel" catchtap="preventClose" catchtouchmove="preventClose">
      <view class="filter-panel-hd">
        <text class="filter-panel-title">查询条件</text>
        <text class="filter-panel-close" bindtap="closeFilterPanel">关闭</text>
      </view>
      <view class="filter-field">
        <text class="filter-label">关键词</text>
        <view class="filter-input-wrap">
          <input
            class="filter-input"
            placeholder="姓名/手机/单号/设备/组织"
            placeholder-class="filter-input-placeholder"
            value="{{queryForm.keyword}}"
            bindinput="onQueryKeywordInput"
            confirm-type="search"
            bindconfirm="applyQuery"
          />
        </view>
      </view>
      <view class="filter-field">
        <text class="filter-label">方向</text>
        <picker mode="selector" range="{{dirOptions}}" bindchange="onDirChange">
          <view class="picker-value">{{queryForm.dir || '全部'}}</view>
        </picker>
      </view>
      <view class="filter-field">
        <text class="filter-label">核验方式</text>
        <picker mode="selector" range="{{methodOptions}}" bindchange="onMethodChange">
          <view class="picker-value">{{queryForm.method || '全部'}}</view>
        </picker>
      </view>
      <view class="filter-actions">
        <button class="btn-reset" bindtap="resetQuery">重置</button>
        <button class="btn-query" bindtap="applyQuery">查询</button>
      </view>
    </view>
  </view>
</view>
