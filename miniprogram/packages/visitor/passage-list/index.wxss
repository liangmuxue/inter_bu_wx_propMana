.page {
  height: 100vh;
  width: 100%;
  max-width: 100vw;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-bg);
  box-sizing: border-box;
}

.scope-bar {
  flex-shrink: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--color-border);
  align-items: center;
}

.scope-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.filter-trigger {
  flex-shrink: 0;
  position: relative;
  padding: 12rpx 20rpx;
  margin: 12rpx 24rpx 12rpx 0;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: #F7FAFC;
  border-radius: var(--radius);
}

.filter-trigger.active {
  color: var(--color-primary);
  background: #EBF4FF;
  font-weight: 600;
}

.filter-dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E53E3E;
}

.filter-bar-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  background: #fff;
  border-bottom: 1rpx solid var(--color-border);
}

.filter-bar {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.filter-inner {
  display: inline-flex;
  padding: 12rpx 8rpx 12rpx 24rpx;
  gap: 12rpx;
  align-items: center;
}

.filter-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: #F7FAFC;
  border-radius: 999rpx;
}

.filter-item.active {
  color: #fff;
  background: var(--color-primary);
  font-weight: 600;
}

.filter-tail {
  width: 8rpx;
  flex-shrink: 0;
}

.query-summary {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: #F7FAFC;
  border-bottom: 1rpx solid var(--color-border);
}

.query-reset {
  color: var(--color-primary);
}

.hint-bar {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
  background: #F7FAFC;
}

.list-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.item-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.item-code {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.kv-row {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.kv-label {
  flex-shrink: 0;
  width: 140rpx;
  color: var(--color-text-secondary);
}

.kv-value {
  flex: 1;
  color: var(--color-text);
  word-break: break-all;
}

.kv-value.link {
  color: var(--color-primary);
}

.filter-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.filter-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.filter-panel-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.filter-panel-title {
  font-size: 30rpx;
  font-weight: 600;
}

.filter-panel-close {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.filter-field {
  margin-bottom: 24rpx;
}

.filter-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.filter-input-wrap,
.picker-value {
  background: #F7FAFC;
  border-radius: var(--radius);
  overflow: hidden;
}

.filter-input,
.picker-value {
  display: block;
  width: 100%;
  min-height: 80rpx;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.filter-input-placeholder {
  color: #A0AEC0;
}

.filter-actions {
  display: flex;
  gap: 16rpx;
}

.btn-reset,
.btn-query {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
  line-height: 2.2;
  border-radius: var(--radius);
}

.btn-reset {
  color: var(--color-text);
  background: #EDF2F7;
}

.btn-query {
  color: #fff;
  background: var(--color-primary);
}

.btn-reset::after,
.btn-query::after {
  border: none;
}
