@import "../visitor-detail/index.wxss";

.status-hero.tone-amber {
  background: linear-gradient(135deg, #C05621, #DD6B20);
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.card-title-row .card-title {
  margin-bottom: 0;
}

.card-meta {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.kv-value.is-reject-remark {
  color: var(--color-danger);
}

.flow-list {
  margin-top: 4rpx;
}

.flow-item {
  padding: 16rpx 0;
  border-top: 1rpx solid var(--color-border);
}

.flow-item:first-child {
  border-top: none;
  padding-top: 0;
}

.flow-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.flow-item-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.approve-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--color-border);
  box-sizing: border-box;
  z-index: 20;
}

.approve-dock button {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
  line-height: 2.2;
  border-radius: var(--radius);
}

.approve-dock .btn-reject {
  color: var(--color-danger);
  background: #FFF5F5;
}

.approve-dock .btn-pass {
  color: #fff;
  background: var(--color-primary);
}

.approve-dock button::after {
  border: none;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet-mask.is-nested {
  z-index: 110;
  background: rgba(0, 0, 0, 0.35);
}

.decide-sheet {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
}

.sheet-close {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.decide-context {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
}

.decide-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #EBF4FF;
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.decide-context-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.decide-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.decide-sub {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.sheet-field {
  margin-bottom: 24rpx;
}

.sheet-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.perm-field {
  position: relative;
  padding: 20rpx 48rpx 20rpx 24rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
}

.perm-field.is-locked {
  padding-right: 24rpx;
  opacity: 0.92;
}

.perm-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.perm-devices {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.perm-arrow {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: var(--color-text-secondary);
  line-height: 1;
}

.perm-locked-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #A0AEC0;
}

.perm-hint {
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.perm-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--color-border);
}

.perm-option:first-of-type {
  border-top: none;
}

.perm-option.active .perm-name {
  color: var(--color-primary);
}

.perm-option-copy {
  flex: 1;
  min-width: 0;
}

.perm-check {
  flex-shrink: 0;
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.remark-input {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  background: #F7FAFC;
  border-radius: var(--radius);
  font-size: 26rpx;
}

.sheet-actions {
  display: flex;
  gap: 16rpx;
}

.sheet-actions button {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
  line-height: 2.2;
  border-radius: var(--radius);
}

.btn-sheet-cancel {
  color: var(--color-text);
  background: #EDF2F7;
}

.btn-sheet-pass {
  color: #fff;
  background: var(--color-primary);
}

.btn-sheet-reject {
  color: #fff;
  background: var(--color-danger);
}

.sheet-actions button::after {
  border: none;
}
