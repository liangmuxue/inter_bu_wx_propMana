.page {
  min-height: 100vh;
  background: var(--color-bg);
  box-sizing: border-box;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.status-hero {
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.status-hero.tone-blue { background: linear-gradient(135deg, #2B6CB0, #1A5FDB); }
.status-hero.tone-green { background: linear-gradient(135deg, #2F855A, #38A169); }
.status-hero.tone-red { background: linear-gradient(135deg, #C53030, #E53E3E); }
.status-hero.tone-slate { background: linear-gradient(135deg, #4A5568, #718096); }

.hero-eyebrow {
  display: block;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  opacity: 0.85;
  margin-bottom: 12rpx;
}

.hero-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hero-checkin {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.hero-checkin.tone-green {
  background: rgba(230, 247, 237, 0.95);
  color: #1f6b45;
}

.hero-checkin.tone-slate {
  background: rgba(237, 242, 247, 0.95);
  color: #445b64;
}

.hero-hint {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  opacity: 0.92;
}

.kv-row {
  display: flex;
  gap: 16rpx;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.45;
}

.kv-label {
  flex-shrink: 0;
  width: 160rpx;
  color: var(--color-text-secondary);
}

.kv-value {
  flex: 1;
  color: var(--color-text);
  word-break: break-all;
}

.companion-block {
  padding: 16rpx 0;
  border-top: 1rpx solid var(--color-border);
}

.companion-block:first-of-type {
  border-top: none;
  padding-top: 0;
}

.companion-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.companion-empty {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  padding: 8rpx 0;
}

.perm-group {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.perm-revoked {
  flex-shrink: 0;
}

.action-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--color-border);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  z-index: 20;
}

.action-btn {
  width: 100%;
  margin: 0;
}

.ghost-btn {
  margin: 0;
  font-size: 28rpx;
  line-height: 2.2;
  color: var(--color-primary);
  background: #EBF4FF;
  border-radius: var(--radius);
  border: none;
}

.ghost-btn::after {
  border: none;
}

.danger-btn {
  width: 100%;
  margin: 0;
  font-size: 28rpx;
  line-height: 2.2;
  color: #fff;
  background: var(--color-danger);
  border-radius: var(--radius);
  border: none;
}

.danger-btn::after {
  border: none;
}
