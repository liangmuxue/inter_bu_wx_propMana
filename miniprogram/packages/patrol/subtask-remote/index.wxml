<view class="container" wx:if="{{subtask}}">
  <view class="card">
    <view class="card-title">{{subtask.itemName}}</view>
    <view class="info-row"><text class="info-label">子项编号</text><text class="info-value">{{subtask.code}}</text></view>
    <view class="info-row"><text class="info-label">巡检项</text><text class="info-value">{{subtask.itemId}}</text></view>
    <view class="info-row"><text class="info-label">检查方法</text><text class="info-value">远程巡检</text></view>
    <view class="info-row"><text class="info-label">问题处理人</text><text class="info-value">{{subtask.issueHandlerName}}</text></view>
    <view class="info-row"><text class="info-label">实际执行人</text><text class="info-value">{{subtask.completedByName || '—'}}</text></view>
  </view>

  <view class="card standard-panel">
    <view class="standard-label">检查标准</view>
    <text class="standard-text">{{subtask.standard}}</text>
    <block wx:if="{{refImage}}">
      <text class="ref-image-label">参考图片</text>
      <view class="ref-image-stage tone-{{refImage.tone}}">
        <view class="ref-image-placeholder">
          <text class="ref-image-icon">图</text>
          <text class="ref-image-name">{{refImage.itemName}}</text>
          <text class="ref-image-code">{{refImage.itemId}}</text>
        </view>
      </view>
    </block>
  </view>

  <view class="card monitor-card" wx:if="{{viewOnly}}">
    <view class="card-title">关联监控设备</view>
    <view wx:if="{{devices.length}}" class="device-query-list">
      <view
        wx:for="{{devices}}"
        wx:key="id"
        class="device-query-item"
        bindtap="queryDevice"
        data-index="{{index}}"
      >
        <text class="device-query-icon">📹</text>
        <text class="device-query-label">{{item.id}} {{item.name}}</text>
        <text class="device-query-action">查看 ›</text>
      </view>
    </view>
    <text wx:else class="device-empty-hint">暂无关联监控设备</text>
  </view>

  <view class="card monitor-card" wx:if="{{!viewOnly}}">
    <view class="card-title">关联监控设备</view>
    <view class="field-label">选择设备</view>
    <picker mode="selector" range="{{deviceLabels}}" value="{{deviceIndex}}" bindchange="onDeviceChange">
      <view class="device-picker">
        <text class="device-picker-text">{{currentDeviceLabel}}</text>
        <text class="device-picker-arrow">▼</text>
      </view>
    </picker>

    <view class="tab-row">
      <text class="tab-item {{monitorTab==='live'?'active':''}}" bindtap="onMonitorTab" data-tab="live">实时视频</text>
      <text class="tab-item {{monitorTab==='replay'?'active':''}}" bindtap="onMonitorTab" data-tab="replay">录像回放</text>
      <text class="tab-item {{monitorTab==='snapshot'?'active':''}}" bindtap="onMonitorTab" data-tab="snapshot">抓拍图片</text>
    </view>
    <view class="rule-hint" wx:if="{{ruleHint}}">{{ruleHint}}</view>

    <block wx:if="{{monitorTab === 'live'}}">
      <view class="monitor-toolbar">
        <view class="monitor-toolbar-left">
          <text class="tool-chip" bindtap="onToggleMonitorFullscreen">全屏</text>
        </view>
        <view class="monitor-toolbar-right">
          <text class="tool-chip {{streamType==='main'?'active':''}}" bindtap="onStreamSwitch" data-stream="main">主码流</text>
          <text class="tool-chip {{streamType==='sub'?'active':''}}" bindtap="onStreamSwitch" data-stream="sub">子码流</text>
        </view>
      </view>
      <view class="monitor-stage fit-{{videoFit}}">
        <view class="monitor-preview {{videoFit==='contain' ? 'is-fit-contain' : ''}}">
          <text class="monitor-label">实时视频预览（演示）</text>
          <text class="monitor-meta">{{monitorMeta}}</text>
        </view>
      </view>
      <view class="video-control-bar">
        <view class="vc-btn {{videoFit==='contain'?'active':''}}" bindtap="onMonitorVc" data-action="fit">
          <text class="vc-icon">⤢</text>
        </view>
        <view class="vc-btn" bindtap="onMonitorVc" data-action="capture">
          <text class="vc-icon">📷</text>
        </view>
        <view class="vc-btn" bindtap="onMonitorVc" data-action="replay">
          <text class="vc-icon">⏪</text>
        </view>
        <view class="vc-btn {{audioOn?'active':''}}" bindtap="onMonitorVc" data-action="audio">
          <text class="vc-icon">{{audioOn ? '🔊' : '🔇'}}</text>
        </view>
      </view>
    </block>

    <block wx:elif="{{monitorTab === 'replay'}}">
      <view class="monitor-preview replay">
        <text class="monitor-label">录像回放（演示）</text>
        <text class="monitor-meta">{{currentDeviceLabel}} · 最长 {{ruleReplayDuration}}</text>
      </view>
      <view class="playback-bar">
        <view class="playback-controls">
          <text class="playback-btn">▶</text>
          <text class="playback-btn">⏸</text>
          <picker mode="selector" range="{{replaySpeedOptions}}" value="{{replaySpeedIndex}}" bindchange="onReplaySpeedChange">
            <view class="playback-speed-picker">
              <text class="playback-speed-label">{{replaySpeedLabel}}</text>
              <text class="playback-speed-arrow">▼</text>
            </view>
          </picker>
        </view>
        <view class="timeline-ruler">
          <text>08:00</text><text>12:00</text><text>16:00</text>
        </view>
        <view class="timeline-track">
          <view class="timeline-segment"></view>
          <view class="timeline-cursor"></view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="snapshot-status">共 {{snapshotTotal}} 张抓拍（保留 {{ruleSnapshotRetainDays}} 天）· 当前第 {{snapshotIndex + 1}} 张 · 左右滑动切换</view>
      <swiper class="snapshot-swiper" current="{{snapshotIndex}}" bindchange="onSnapshotSwipe">
        <swiper-item wx:for="{{snapshotTimes}}" wx:key="*this">
          <view class="snapshot-main">
            <text class="snapshot-device">{{currentDeviceLabel}}</text>
            <text class="snapshot-time">2026-06-01 {{item}}</text>
          </view>
        </swiper-item>
      </swiper>
      <scroll-view
        scroll-x
        class="snapshot-thumb-scroll"
        scroll-into-view="{{snapshotScrollIntoView}}"
        scroll-with-animation
        enable-flex
      >
        <view class="snapshot-thumb-row">
          <view
            wx:for="{{snapshotTimes}}"
            wx:key="*this"
            id="snap-{{index}}"
            class="snapshot-thumb {{snapshotIndex === index ? 'active' : ''}}"
            bindtap="onSnapshotSelect"
            data-index="{{index}}"
          >
            <text>{{item}}</text>
          </view>
        </view>
      </scroll-view>
    </block>
  </view>

  <view class="card result-panel">
    <view class="card-title">巡检结果</view>
    <block wx:if="{{viewOnly}}">
      <view class="info-row"><text class="info-label">检查结果</text><text class="info-value">{{subtask.result || '—'}}</text></view>
      <view class="info-row"><text class="info-label">备注说明</text><text class="info-value">{{subtask.remark || '—'}}</text></view>
      <view class="info-row" wx:if="{{subtask.completedAt}}"><text class="info-label">完成时间</text><text class="info-value">{{subtask.completedAt}}</text></view>
      <view wx:if="{{subtask.result === '异常' && savedIssues.length}}" class="issues-readonly">
        <text class="issues-head-title">巡检问题</text>
        <view wx:for="{{savedIssues}}" wx:key="id" class="issue-read-card">
          <text class="issue-read-title">问题 {{index + 1}}</text>
          <text class="issue-read-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
          <view class="upload-grid readonly" wx:if="{{item.images.length}}">
            <image
              wx:for="{{item.images}}"
              wx:for-item="img"
              wx:for-index="imgIndex"
              wx:key="path"
              class="upload-thumb previewable"
              src="{{img.path}}"
              mode="aspectFill"
              bindtap="previewSavedIssueImage"
              data-index="{{index}}"
              data-img-index="{{imgIndex}}"
            />
          </view>
          <view wx:if="{{item.attachments.length}}" class="attachment-list">
            <view
              wx:for="{{item.attachments}}"
              wx:for-item="att"
              wx:for-index="attIndex"
              wx:key="name"
              class="attachment-item playable"
              bindtap="playSavedIssueAttachment"
              data-index="{{index}}"
              data-att-index="{{attIndex}}"
            >
              <text class="attachment-icon">📎</text>
              <text class="attachment-label">{{att.label || att.name}}</text>
              <text wx:if="{{att.durationSec}}" class="attachment-duration">{{att.durationSec}}″</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    <block wx:else>
      <radio-group bindchange="onResultChange">
        <label class="radio-row"><radio value="正常" checked="{{result==='正常'}}" />正常</label>
        <label class="radio-row"><radio value="异常" checked="{{result==='异常'}}" />异常</label>
      </radio-group>
      <view class="field-label">备注说明</view>
      <textarea class="textarea" placeholder="选填，补充巡检情况" value="{{remark}}" bindinput="onRemarkInput" maxlength="500" />

      <block wx:if="{{result==='异常'}}">
        <view class="issues-editor">
          <view class="issues-editor-head">
            <text class="issues-head-title">巡检问题</text>
            <text class="issues-head-hint">异常时可提交多个问题；每个问题须填写文字描述，图片与视频附件选填</text>
          </view>
          <view wx:for="{{issues}}" wx:key="id" class="issue-edit-card">
            <view class="issue-edit-head">
              <text class="issue-edit-title">问题 {{index + 1}}</text>
              <text wx:if="{{index > 0}}" class="issue-remove" bindtap="removeIssue" data-index="{{index}}">删除</text>
            </view>
            <view class="field-label req">问题描述</view>
            <textarea class="textarea" placeholder="请输入问题描述" value="{{item.desc}}" bindinput="onIssueDescInput" data-index="{{index}}" maxlength="500" />
            <view class="field-label">问题图片</view>
            <text class="field-hint">选填，最多 {{maxImages}} 张</text>
            <view class="upload-grid">
              <view wx:if="{{item.images.length < maxImages}}" class="upload-add" bindtap="chooseIssueImages" data-index="{{index}}">
                <text class="upload-add-icon">+</text>
                <text class="upload-add-text">上传图片</text>
              </view>
              <view wx:for="{{item.images}}" wx:for-item="img" wx:for-index="imgIndex" wx:key="path" class="upload-item">
                <image class="upload-thumb previewable" src="{{img.path}}" mode="aspectFill" bindtap="previewIssueImage" data-index="{{index}}" data-img-index="{{imgIndex}}" />
                <text class="upload-remove" bindtap="removeIssueImage" data-index="{{index}}" data-img-index="{{imgIndex}}">×</text>
              </view>
            </view>
            <view class="field-label">问题附件</view>
            <text class="field-hint">选填，可上传多个视频文件</text>
            <view class="attachment-actions">
              <button class="tool-btn secondary" bindtap="chooseIssueAttachments" data-index="{{index}}">上传视频</button>
            </view>
            <view wx:if="{{item.attachments.length}}" class="attachment-list editable">
              <view wx:for="{{item.attachments}}" wx:for-item="att" wx:for-index="attIndex" wx:key="path" class="attachment-row">
                <text
                  class="attachment-name playable"
                  bindtap="playIssueAttachment"
                  data-index="{{index}}"
                  data-att-index="{{attIndex}}"
                >📎 {{att.label || att.name}}</text>
                <text class="attachment-remove" bindtap="removeIssueAttachment" data-index="{{index}}" data-att-index="{{attIndex}}">删除</text>
              </view>
            </view>
          </view>
          <button class="add-issue-btn" bindtap="addIssue">+ 添加问题</button>
        </view>
      </block>
    </block>
  </view>

  <button wx:if="{{!viewOnly}}" class="btn-primary submit-btn" bindtap="submit">提交巡检结果</button>

  <view wx:if="{{showDeviceDetail}}" class="device-detail-mask" bindtap="closeDeviceDetail">
    <view class="device-detail-panel" catchtap="noop">
      <view class="device-detail-title">监控设备</view>
      <view class="device-detail-body">
        <view wx:for="{{deviceDetailRows}}" wx:key="label" class="device-detail-row">
          <text class="device-detail-label">{{item.label}}</text>
          <text class="device-detail-value">{{item.value}}</text>
        </view>
      </view>
      <button class="device-detail-btn" bindtap="closeDeviceDetail">关闭</button>
    </view>
  </view>
</view>
