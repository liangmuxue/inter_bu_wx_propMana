@import '../common/patrol-subtask.wxss';

.timeline {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.timeline-item {
  display: flex;
  gap: 20rpx;
  padding-bottom: 28rpx;
  overflow: hidden;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-axis {
  width: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--color-primary);
  margin-top: 8rpx;
  flex-shrink: 0;
}

.timeline-dot.tone-discover { background: var(--color-primary); }
.timeline-dot.tone-rectify { background: var(--color-warning); }
.timeline-dot.tone-pass { background: var(--color-success); }
.timeline-dot.tone-reject { background: var(--color-danger); }

.timeline-line {
  flex: 1;
  width: 2rpx;
  background: var(--color-border);
  margin-top: 8rpx;
  min-height: 40rpx;
}

.timeline-body {
  flex: 1;
  min-width: 0;
}

.timeline-time {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.timeline-head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 8rpx;
  line-height: 1.5;
}

.timeline-actor {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.timeline-action {
  font-size: 28rpx;
  color: var(--color-text);
}

.timeline-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  margin-bottom: 12rpx;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.timeline-media {
  margin-top: 12rpx;
}

.issue-images-block {
  margin-top: 12rpx;
}

.media-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.issue-image-placeholder {
  width: 160rpx;
  min-height: 160rpx;
  border-radius: var(--radius);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  box-sizing: border-box;
}

.issue-image-placeholder.tone-default { background: linear-gradient(145deg, #f7fafc 0%, #edf2f7 100%); }
.issue-image-placeholder.tone-garage { background: linear-gradient(145deg, #fffaf0 0%, #feebc8 100%); }
.issue-image-placeholder.tone-ups { background: linear-gradient(145deg, #fff5f5 0%, #fed7d7 100%); }
.issue-image-placeholder.tone-hydrant { background: linear-gradient(145deg, #ebf8ff 0%, #bee3f8 100%); }
.issue-image-placeholder.tone-env { background: linear-gradient(145deg, #f0fff4 0%, #c6f6d5 100%); }

.placeholder-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 12rpx;
  background: rgba(26, 95, 219, 0.12);
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.placeholder-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.3;
  word-break: break-all;
}

.detail-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  z-index: 20;
}

.detail-action-bar .action-btn {
  font-size: 28rpx;
  color: var(--color-primary);
  padding: 8rpx 16rpx;
}

.detail-action-bar .action-btn.emphasis {
  color: var(--color-success);
  font-weight: 600;
}

.detail-action-bar .action-sep {
  font-size: 24rpx;
  color: var(--color-border);
  margin: 0 4rpx;
}

.container.with-action-bar {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}
