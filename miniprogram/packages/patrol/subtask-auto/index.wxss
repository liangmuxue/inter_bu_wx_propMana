@import '../common/patrol-subtask.wxss';

.hint-card {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: #F0FFF4;
  border-radius: var(--radius);
  font-size: 24rpx;
  color: var(--color-success);
  line-height: 1.5;
}
.detail-block { margin-top: 16rpx; padding-top: 0; }
.detail-label { display: block; font-size: 26rpx; color: var(--color-text-secondary); margin-bottom: 8rpx; }
.detail-text { font-size: 28rpx; line-height: 1.5; }
.issue-block { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid var(--color-border); }
.issue-label { display: block; font-size: 26rpx; color: var(--color-warning); margin-bottom: 8rpx; }
.issue-text { display: block; font-size: 28rpx; line-height: 1.5; margin-top: 8rpx; }
.loading-card { text-align: center; color: var(--color-text-secondary); font-size: 28rpx; }
