<view class="page">
  <view class="scope-bar">
    <view
      class="scope-item {{scope === 'org' ? 'active' : ''}}"
      bindtap="onScopeChange"
      data-scope="org"
    >组织问题</view>
    <view
      class="scope-item {{scope === 'mine' ? 'active' : ''}}"
      bindtap="onScopeChange"
      data-scope="mine"
    >与我相关</view>
    <view class="filter-trigger {{queryActive ? 'active' : ''}}" bindtap="openFilterPanel">
      <text class="filter-icon">筛选</text>
      <text wx:if="{{queryActive}}" class="filter-dot"></text>
    </view>
  </view>

  <scroll-view scroll-x class="filter-bar" enhanced show-scrollbar="{{false}}">
    <view class="filter-inner">
      <view
        wx:for="{{tabs}}"
        wx:key="id"
        class="filter-item {{tab === item.id ? 'active' : ''}}"
        bindtap="onTabChange"
        data-tab="{{item.id}}"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="query-summary" wx:if="{{queryActive}}">
    <text>已启用高级筛选</text>
    <text class="query-reset" bindtap="resetQuery">清除</text>
  </view>

  <view class="container">
    <view wx:for="{{list}}" wx:key="issueNo" class="card issue-card">
      <view bindtap="openIssue" data-no="{{item.issueNo}}">
        <view class="issue-head">
          <view class="issue-title">{{item.desc}}</view>
          <text class="tag {{item.statusClass}}">{{item.status}}</text>
        </view>
        <view class="issue-fields">
          <view class="issue-field">
            <text class="issue-field-label">问题编号</text>
            <text class="issue-field-value">{{item.issueNo}}</text>
          </view>
          <view class="issue-field">
            <text class="issue-field-label">来源</text>
            <text class="issue-field-value">{{item.source}}</text>
          </view>
          <view class="issue-field">
            <text class="issue-field-label">关联任务</text>
            <text class="issue-field-value">{{item.taskLabel}}</text>
          </view>
          <view class="issue-field">
            <text class="issue-field-label">关联巡检对象</text>
            <text class="issue-field-value">{{item.objectLabel}}</text>
          </view>
          <view class="issue-field">
            <text class="issue-field-label">关联巡检项</text>
            <text class="issue-field-value">{{item.itemLabel}}</text>
          </view>
          <view class="issue-field">
            <text class="issue-field-label">处理人</text>
            <text class="issue-field-value">{{item.handlerName}}</text>
          </view>
          <view class="issue-field">
            <text class="issue-field-label">创建人</text>
            <text class="issue-field-value">{{item.creatorName}}</text>
          </view>
          <view class="issue-field">
            <text class="issue-field-label">创建时间</text>
            <text class="issue-field-value">{{item.createdAt}}</text>
          </view>
        </view>
      </view>
      <view class="issue-actions" catchtap="preventClose">
        <text class="action-btn" bindtap="openIssue" data-no="{{item.issueNo}}">详情</text>
        <block wx:if="{{item.canEdit}}">
          <text class="action-sep">|</text>
          <text class="action-btn" bindtap="openIssueAction" data-url="{{item.editUrl}}">编辑</text>
        </block>
        <block wx:if="{{item.canRectify}}">
          <text class="action-sep">|</text>
          <text class="action-btn emphasis" bindtap="openIssueAction" data-url="{{item.rectifyUrl}}">整改</text>
        </block>
        <block wx:if="{{item.canReinspect}}">
          <text class="action-sep">|</text>
          <text class="action-btn emphasis" bindtap="openIssueAction" data-url="{{item.reinspectUrl}}">复检</text>
        </block>
      </view>
    </view>
    <view wx:if="{{!loading && !list.length}}" class="empty">暂无{{scopeHint}}{{tabHint}}问题</view>
  </view>

  <view wx:if="{{showFilterPanel}}" class="filter-mask" bindtap="closeFilterPanel" catchtouchmove="preventClose">
    <view class="filter-panel" catchtap="preventClose" catchtouchmove="preventClose">
      <view class="filter-panel-hd">
        <text class="filter-panel-title">查询条件</text>
        <text class="filter-panel-close" bindtap="closeFilterPanel">关闭</text>
      </view>
      <view class="filter-field">
        <text class="filter-label">问题状态</text>
        <picker mode="selector" range="{{statusOptions}}" range-key="label" value="{{queryForm.statusIndex}}" bindchange="onStatusPick">
          <view class="filter-picker">{{statusOptions[queryForm.statusIndex].label}}</view>
        </picker>
      </view>
      <view class="filter-field">
        <text class="filter-label">问题来源</text>
        <picker mode="selector" range="{{sourceOptions}}" range-key="label" value="{{queryForm.sourceIndex}}" bindchange="onSourcePick">
          <view class="filter-picker">{{sourceOptions[queryForm.sourceIndex].label}}</view>
        </picker>
      </view>
      <view class="filter-field">
        <text class="filter-label">关键词</text>
        <view class="filter-input-wrap">
          <input
            class="filter-input"
            placeholder="问题编号/描述/任务/对象/巡检项/处理人"
            placeholder-class="filter-input-placeholder"
            value="{{queryForm.keyword}}"
            bindinput="onQueryKeywordInput"
            confirm-type="search"
            bindconfirm="applyQuery"
          />
        </view>
      </view>
      <view class="filter-actions">
        <button class="btn-reset" bindtap="resetQuery">重置</button>
        <button class="btn-query" bindtap="applyQuery">查询</button>
      </view>
    </view>
  </view>
</view>
