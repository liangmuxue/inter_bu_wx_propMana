.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  gap: 24rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  flex-shrink: 0;
  width: 200rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  text-align: right;
  line-height: 1.4;
}

.subtask-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.subtask-row:last-child {
  border-bottom: none;
}

.subtask-main {
  flex: 1;
  min-width: 0;
}

.subtask-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.subtask-code {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.subtask-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.subtask-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.subtask-status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.subtask-actions {
  flex-shrink: 0;
  padding-top: 8rpx;
}

.action-btn {
  margin: 0;
}

.view-btn {
  background: #fff;
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
}

.exec-hint {
  display: block;
  max-width: 160rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.detail-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  z-index: 20;
}

.detail-action-bar .action-btn {
  font-size: 28rpx;
  color: var(--color-primary);
  padding: 8rpx 16rpx;
}

.detail-action-bar .action-btn.emphasis {
  color: var(--color-success);
  font-weight: 600;
}

.detail-action-bar .action-sep {
  font-size: 24rpx;
  color: var(--color-border);
  margin: 0 4rpx;
}

.container.with-action-bar {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.reassign-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.reassign-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.reassign-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.reassign-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.reassign-close {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  padding: 8rpx;
}

.reassign-hint {
  display: block;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.reassign-row,
.reassign-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.reassign-label {
  flex-shrink: 0;
  width: 180rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.reassign-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  text-align: right;
  line-height: 1.4;
}

.reassign-picker {
  flex: 1;
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--color-text);
  text-align: right;
  box-sizing: border-box;
}

.reassign-picker.placeholder {
  color: var(--color-text-secondary);
}

.reassign-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.reassign-actions .btn-cancel,
.reassign-actions .btn-confirm {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
}

.reassign-actions .btn-cancel {
  background: #fff;
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
}
