/* 巡检子项执行/结果页共用样式（现场/远程/自动） */
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  gap: 16rpx;
}
.info-row:last-child { border-bottom: none; }
.info-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
  width: 160rpx;
}
.info-value {
  font-size: 28rpx;
  text-align: right;
  flex: 1;
  min-width: 0;
  line-height: 1.4;
  word-break: break-all;
  overflow-wrap: anywhere;
}
.standard-panel { margin-bottom: 24rpx; }
.standard-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}
.standard-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--color-text);
}
.ref-image-label {
  display: block;
  margin-top: 20rpx;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
.ref-image-stage {
  border-radius: var(--radius);
  overflow: hidden;
  min-height: 220rpx;
}
.ref-image-stage.tone-fire { background: linear-gradient(145deg, #fff5f5 0%, #fed7d7 100%); }
.ref-image-stage.tone-boiler { background: linear-gradient(145deg, #fffaf0 0%, #feebc8 100%); }
.ref-image-stage.tone-hydrant { background: linear-gradient(145deg, #ebf8ff 0%, #bee3f8 100%); }
.ref-image-stage.tone-env { background: linear-gradient(145deg, #f0fff4 0%, #c6f6d5 100%); }
.ref-image-stage.tone-default { background: linear-gradient(145deg, #f7fafc 0%, #edf2f7 100%); }
.ref-image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 220rpx;
  padding: 24rpx;
  box-sizing: border-box;
}
.ref-image-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 12rpx;
  background: rgba(26, 95, 219, 0.12);
  color: var(--color-primary);
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.ref-image-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  text-align: center;
}
.ref-image-code {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
.result-panel { margin-top: 0; }
.radio-row { display: block; padding: 16rpx 0; }
.field-label {
  margin-top: 16rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
.field-label.req::before { content: '* '; color: var(--color-danger); }
.field-hint {
  display: block;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
.filter-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--color-text);
  background: #F7FAFC;
  border-radius: var(--radius);
  border: 1rpx solid var(--color-border);
  min-height: 88rpx;
  box-sizing: border-box;
}
.filter-picker::after {
  content: '▼';
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-left: 16rpx;
  flex-shrink: 0;
}
.textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius);
  box-sizing: border-box;
  font-size: 28rpx;
}
.submit-btn { width: 100%; margin-top: 8rpx; }
.issues-readonly {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}
.issues-head-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 8rpx;
}
.issues-head-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}
.issue-read-card {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #FFFAF0;
  border-radius: var(--radius);
  min-width: 0;
  overflow: hidden;
}
.issue-read-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-warning);
}
.issue-read-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
  overflow-wrap: anywhere;
}
.upload-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 8rpx; }
.upload-grid.readonly { margin-top: 12rpx; }
.upload-thumb.previewable { cursor: pointer; }
.voice-preview.playable { cursor: pointer; }
.voice-preview.playable.playing { border-color: var(--color-primary); background: #EBF4FF; }
.voice-preview.playable.playing .voice-play { background: var(--color-warning); }
.upload-add {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 1rpx dashed var(--color-border);
  border-radius: var(--radius);
}
.upload-add-icon { font-size: 40rpx; color: var(--color-primary); line-height: 1; }
.upload-add-text { margin-top: 8rpx; font-size: 22rpx; color: var(--color-text-secondary); }
.upload-item { position: relative; width: 160rpx; height: 160rpx; }
.upload-thumb { width: 160rpx; height: 160rpx; border-radius: var(--radius); background: #EDF2F7; }
.upload-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-danger);
  color: #fff;
  font-size: 28rpx;
}
.attachment-list { margin-top: 8rpx; }
.attachment-item { display: block; font-size: 26rpx; color: var(--color-text); padding: 8rpx 0; }
.attachment-item.playable {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.attachment-item.playable .attachment-icon { margin-right: 8rpx; font-size: 26rpx; }
.attachment-item.playable .attachment-label {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-primary);
}
.attachment-item.playable .attachment-duration {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-left: 12rpx;
}
.attachment-list.editable .attachment-name.playable {
  color: var(--color-primary);
}
.attachment-list.editable .attachment-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.attachment-list.editable .attachment-row:last-child { border-bottom: none; }
.attachment-name { font-size: 26rpx; color: var(--color-text); flex: 1; }
.attachment-remove { font-size: 24rpx; color: var(--color-danger); margin-left: 16rpx; }
.issues-editor { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--color-border); }
.issues-editor-head { margin-bottom: 16rpx; }
.issue-edit-card {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #F8FAFC;
  border-radius: var(--radius);
  border: 1rpx solid var(--color-border);
}
.issue-edit-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.issue-edit-title { font-size: 26rpx; font-weight: 600; }
.issue-remove { font-size: 24rpx; color: var(--color-danger); }
.issue-tools { margin-top: 12rpx; }
.tool-btn {
  display: inline-block;
  margin: 0;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  background: #EBF4FF;
  color: var(--color-primary);
  border-radius: var(--radius);
}
.tool-btn.recording { background: #FED7D7; color: var(--color-danger); }
.tool-btn.secondary { background: #EDF2F7; color: var(--color-text); }
.voice-preview {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 16rpx;
  background: #fff;
  border-radius: var(--radius);
  border: 1rpx solid var(--color-border);
}
.voice-preview-main { display: flex; align-items: center; gap: 12rpx; }
.voice-play {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: 22rpx;
}
.voice-meta { font-size: 26rpx; color: var(--color-text); }
.voice-remove { font-size: 24rpx; color: var(--color-danger); }
.add-issue-btn {
  width: 100%;
  margin-top: 8rpx;
  background: #EDF2F7;
  color: var(--color-text);
  font-size: 28rpx;
  border-radius: var(--radius);
}
.attachment-actions { margin-bottom: 12rpx; }
