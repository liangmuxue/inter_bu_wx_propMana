<view class="page">
  <view class="scope-bar">
    <view
      class="scope-item {{scope === 'org' ? 'active' : ''}}"
      bindtap="onScopeChange"
      data-scope="org"
    >组织任务</view>
    <view
      class="scope-item {{scope === 'mine' ? 'active' : ''}}"
      bindtap="onScopeChange"
      data-scope="mine"
    >我的任务</view>
    <view class="filter-trigger {{queryActive ? 'active' : ''}}" bindtap="openFilterPanel">
      <text class="filter-icon">筛选</text>
      <text wx:if="{{queryActive}}" class="filter-dot"></text>
    </view>
  </view>

  <scroll-view scroll-x class="filter-bar" enhanced show-scrollbar="{{false}}">
    <view class="filter-inner">
      <view
        wx:for="{{filters}}"
        wx:key="id"
        class="filter-item {{filter === item.id ? 'active' : ''}}"
        bindtap="onFilterChange"
        data-filter="{{item.id}}"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="query-summary" wx:if="{{queryActive}}">
    <text>已启用高级筛选</text>
    <text class="query-reset" bindtap="resetQuery">清除</text>
  </view>

  <view class="container">
    <view wx:for="{{list}}" wx:key="taskId" class="card task-card" bindtap="openTask" data-id="{{item.taskId}}">
      <view class="task-head">
        <text class="task-name">{{item.planName}}</text>
        <text class="tag {{item.statusClass}}">{{item.status}}</text>
      </view>
      <text class="task-no">{{item.taskId}}</text>
      <text class="task-meta">可执行人 {{item.executorName}}</text>
      <text class="task-meta">{{item.objectName}}</text>
      <text class="task-meta">{{item.scheduled}} · 进度 {{item.progress.done}}/{{item.progress.total}}</text>
      <text class="task-meta" wx:if="{{item.completedAt}}">完成时间 {{item.completedAt}}</text>
      <view class="task-actions" wx:if="{{item.hasManageActions}}" catchtap="preventClose">
        <text wx:if="{{item.canUrge}}" class="task-action" catchtap="onUrge" data-id="{{item.taskId}}">催办</text>
        <text wx:if="{{item.canUrge && item.canReassign}}" class="task-action-sep">|</text>
        <text wx:if="{{item.canReassign}}" class="task-action emphasis" catchtap="onReassign" data-id="{{item.taskId}}">转派</text>
      </view>
    </view>
    <view wx:if="{{!loading && !list.length}}" class="empty">暂无{{scopeHint}}{{emptyHint}}任务</view>
  </view>

  <view wx:if="{{showFilterPanel}}" class="filter-mask" bindtap="closeFilterPanel" catchtouchmove="preventClose">
    <view class="filter-panel" catchtap="preventClose" catchtouchmove="preventClose">
      <view class="filter-panel-hd">
        <text class="filter-panel-title">查询条件</text>
        <text class="filter-panel-close" bindtap="closeFilterPanel">关闭</text>
      </view>
      <view class="filter-field" wx:if="{{scope === 'org'}}">
        <text class="filter-label">执行人</text>
        <picker mode="selector" range="{{executorOptions}}" range-key="label" value="{{queryForm.executorIndex}}" bindchange="onExecutorPick">
          <view class="filter-picker">{{executorOptions[queryForm.executorIndex].label}}</view>
        </picker>
      </view>
      <view class="filter-field">
        <text class="filter-label">检查方法</text>
        <picker mode="selector" range="{{methodOptions}}" range-key="label" value="{{queryForm.methodIndex}}" bindchange="onMethodPick">
          <view class="filter-picker">{{methodOptions[queryForm.methodIndex].label}}</view>
        </picker>
      </view>
      <view class="filter-field">
        <text class="filter-label">任务状态</text>
        <picker mode="selector" range="{{statusOptions}}" range-key="label" value="{{queryForm.statusIndex}}" bindchange="onStatusPick">
          <view class="filter-picker">{{statusOptions[queryForm.statusIndex].label}}</view>
        </picker>
      </view>
      <view class="filter-field">
        <text class="filter-label">关键词</text>
        <view class="filter-input-wrap">
          <input
            class="filter-input"
            placeholder="任务编号/计划名称/巡检对象/执行人"
            placeholder-class="filter-input-placeholder"
            value="{{queryForm.keyword}}"
            bindinput="onQueryKeywordInput"
            confirm-type="search"
            bindconfirm="applyQuery"
          />
        </view>
      </view>
      <view class="filter-actions">
        <button class="btn-reset" bindtap="resetQuery">重置</button>
        <button class="btn-query" bindtap="applyQuery">查询</button>
      </view>
    </view>
  </view>
</view>
