.page {
  min-height: 100vh;
  background: #000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.player {
  width: 100%;
  height: 420rpx;
}

.empty {
  padding: 80rpx 48rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: #fff;
  margin-bottom: 16rpx;
}

.empty-hint {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.65);
}

.meta {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
}

.demo-hint {
  padding: 0 48rpx;
  text-align: center;
}
