.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx 32rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.hero-name {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-all;
}

.hero-meta {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.current-hint {
  margin-bottom: 24rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: #F7FAFC;
  border-radius: var(--radius);
  line-height: 1.45;
}

.form-field {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.req {
  color: var(--color-danger);
}

.search-wrap {
  margin-bottom: 16rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
  overflow: hidden;
}

.search-input {
  display: block;
  width: 100%;
  min-height: 80rpx;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.search-placeholder {
  color: #A0AEC0;
  font-size: 26rpx;
}

.worker-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.worker-tree {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.worker-org-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
}

.form-hint {
  display: block;
  margin: -4rpx 0 12rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.worker-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
  border: 2rpx solid transparent;
}

.worker-item.checked {
  background: #EBF4FF;
  border-color: var(--color-primary);
}

.check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #CBD5E0;
  box-sizing: border-box;
  flex-shrink: 0;
  background: #fff;
}

.check.on {
  border-color: var(--color-primary);
  background: var(--color-primary);
  position: relative;
}

.check.on::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 4rpx;
  width: 10rpx;
  height: 18rpx;
  border: 4rpx solid #fff;
  border-top: 0;
  border-left: 0;
  transform: rotate(45deg);
}

.worker-info {
  flex: 1;
  min-width: 0;
}

.worker-name {
  display: block;
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}

.worker-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.worker-empty {
  padding: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.selected-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-primary);
}

.form-textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.45;
  background: #F7FAFC;
  border-radius: var(--radius);
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.btn-primary,
.btn-secondary {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
  line-height: 2.4;
  border-radius: var(--radius);
}

.btn-primary {
  background: var(--color-primary);
  color: #fff;
}

.btn-secondary {
  background: #EDF2F7;
  color: var(--color-text);
}

.btn-primary::after,
.btn-secondary::after {
  border: none;
}

.empty {
  padding: 120rpx 32rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 28rpx;
}
