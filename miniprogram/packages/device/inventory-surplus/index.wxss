.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 48rpx;
}

.req {
  color: var(--color-danger);
}

.kv-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
  margin-bottom: 8rpx;
}

.kv-label {
  flex-shrink: 0;
  width: 160rpx;
  font-size: 26rpx;
  color: #718096;
}

.kv-value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: var(--color-text);
}

.kv-value.muted {
  color: var(--color-text-secondary);
}

.form-field {
  margin-bottom: 24rpx;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.form-field.half {
  flex: 1;
  min-width: 0;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #4A5568;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  line-height: 80rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
  border: 1rpx solid var(--color-border);
  font-size: 28rpx;
  color: var(--color-text);
}

.form-picker {
  width: 100%;
  min-height: 80rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  line-height: 1.4;
  background: #F7FAFC;
  border-radius: var(--radius);
  border: 1rpx solid var(--color-border);
  font-size: 28rpx;
  color: var(--color-text);
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  line-height: 1.5;
  background: #F7FAFC;
  border-radius: var(--radius);
  border: 1rpx solid var(--color-border);
  font-size: 28rpx;
  color: var(--color-text);
}

.form-hint {
  display: block;
  margin: 8rpx 0 12rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.upload-item,
.upload-add {
  position: relative;
  width: 152rpx;
  height: 152rpx;
  border-radius: var(--radius);
  overflow: hidden;
}

.upload-thumb {
  width: 100%;
  height: 100%;
  background: #EDF2F7;
}

.upload-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
}

.upload-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F7FAFC;
  border: 1rpx dashed var(--color-border);
  color: #A0AEC0;
  font-size: 56rpx;
  line-height: 1;
}

.submit-btn {
  margin-top: 8rpx;
  width: 100%;
}
