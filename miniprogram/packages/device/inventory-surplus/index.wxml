<view class="page">
  <view class="container">
    <view class="card">
      <view class="card-title">盘盈资产信息</view>
      <text class="form-hint">资产编号由系统自动生成；保存后加入本盘点清单（盘盈），审核「核准入账」后才会写入资产台账</text>

      <view class="kv-row">
        <text class="kv-label">资产编号</text>
        <text class="kv-value muted">保存后自动生成</text>
      </view>

      <view class="form-field">
        <text class="form-label">资产名称 <text class="req">*</text></text>
        <input
          class="form-input"
          maxlength="50"
          placeholder="请输入资产名称"
          value="{{name}}"
          bindinput="onNameInput"
        />
      </view>

      <view class="form-field">
        <text class="form-label">资产分类 <text class="req">*</text></text>
        <picker mode="selector" range="{{categoryOptions}}" range-key="name" value="{{categoryIndex}}" bindchange="onCategoryPick">
          <view class="form-picker">{{categoryName || '请选择'}}</view>
        </picker>
      </view>

      <view class="form-row">
        <view class="form-field half">
          <text class="form-label">品牌</text>
          <input class="form-input" maxlength="50" placeholder="选填" value="{{brand}}" bindinput="onBrandInput" />
        </view>
        <view class="form-field half">
          <text class="form-label">型号</text>
          <input class="form-input" maxlength="50" placeholder="选填" value="{{model}}" bindinput="onModelInput" />
        </view>
      </view>

      <view class="form-field">
        <text class="form-label">序列号</text>
        <input class="form-input" maxlength="64" placeholder="选填" value="{{serialNo}}" bindinput="onSerialInput" />
      </view>

      <view class="form-field">
        <text class="form-label">所属组织 <text class="req">*</text></text>
        <picker mode="selector" range="{{orgOptions}}" range-key="name" value="{{orgIndex}}" bindchange="onOrgPick">
          <view class="form-picker">{{orgName || '请选择'}}</view>
        </picker>
      </view>

      <view class="form-field">
        <text class="form-label">所属区域 <text class="req">*</text></text>
        <picker mode="selector" range="{{regionOptions}}" range-key="name" value="{{regionIndex}}" bindchange="onRegionPick">
          <view class="form-picker">{{regionName || '请选择'}}</view>
        </picker>
      </view>

      <view class="form-field">
        <text class="form-label">具体安装位置</text>
        <input class="form-input" maxlength="100" placeholder="如 B2 机房 A区" value="{{location}}" bindinput="onLocationInput" />
      </view>

      <view class="form-field">
        <text class="form-label">标签类型 <text class="req">*</text></text>
        <picker mode="selector" range="{{tagTypeOptions}}" value="{{tagTypeIndex}}" bindchange="onTagTypePick">
          <view class="form-picker">{{tagType || '请选择'}}</view>
        </picker>
        <text class="form-hint">用于移动端盘点与现场识别</text>
      </view>

      <view class="form-row">
        <view class="form-field half">
          <text class="form-label">购置日期</text>
          <picker mode="date" value="{{purchaseDate}}" bindchange="onPurchaseDateChange">
            <view class="form-picker">{{purchaseDate || '请选择'}}</view>
          </picker>
        </view>
        <view class="form-field half">
          <text class="form-label">购置方式</text>
          <picker mode="selector" range="{{purchaseMethodLabels}}" value="{{purchaseMethodIndex}}" bindchange="onPurchaseMethodPick">
            <view class="form-picker">{{purchaseMethod || '请选择'}}</view>
          </picker>
        </view>
      </view>

      <view class="form-row">
        <view class="form-field half">
          <text class="form-label">购置金额（元）</text>
          <input
            class="form-input"
            type="digit"
            placeholder="选填"
            value="{{purchaseAmount}}"
            bindinput="onAmountInput"
          />
        </view>
        <view class="form-field half">
          <text class="form-label">保修期限</text>
          <picker mode="date" value="{{warrantyDate}}" bindchange="onWarrantyDateChange">
            <view class="form-picker">{{warrantyDate || '请选择'}}</view>
          </picker>
        </view>
      </view>

      <view class="form-field">
        <text class="form-label">备注</text>
        <textarea
          class="form-textarea"
          maxlength="500"
          placeholder="选填，最多 500 字"
          value="{{remark}}"
          bindinput="onRemarkInput"
        />
      </view>

      <view class="form-field">
        <text class="form-label">资产图片</text>
        <text class="form-hint">选填，最多 {{maxImages}} 张</text>
        <view class="upload-grid">
          <view class="upload-item" wx:for="{{images}}" wx:key="path">
            <image class="upload-thumb" src="{{item.path}}" mode="aspectFill" bindtap="previewImage" data-index="{{index}}" />
            <view class="upload-remove" catchtap="removeImage" data-index="{{index}}">×</view>
          </view>
          <view class="upload-add" wx:if="{{images.length < maxImages}}" bindtap="chooseImages">+</view>
        </view>
      </view>
    </view>

    <button class="btn-primary submit-btn" loading="{{submitting}}" bindtap="onSubmit">保存</button>
  </view>
</view>
