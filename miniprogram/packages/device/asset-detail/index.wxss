.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  margin-bottom: 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #1A5FDB 0%, #3B82F6 55%, #60A5FA 100%);
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(26, 95, 219, 0.22);
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.hero-code {
  font-size: 24rpx;
  opacity: 0.9;
  letter-spacing: 0.5rpx;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: flex-end;
}

.hero-tags .tag {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.hero-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  margin-bottom: 10rpx;
}

.hero-sub {
  display: block;
  font-size: 24rpx;
  opacity: 0.88;
}

.card {
  margin-bottom: 20rpx;
  padding: 8rpx 28rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid var(--color-border);
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.section-title {
  padding: 20rpx 0 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.kv-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.kv-row:last-child {
  border-bottom: none;
}

.kv-label {
  flex-shrink: 0;
  width: 200rpx;
  font-size: 26rpx;
  color: #718096;
  line-height: 1.5;
}

.kv-value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: var(--color-text);
  word-break: break-all;
  line-height: 1.5;
}

.remark-text {
  display: block;
  margin: 8rpx 0 12rpx;
  padding: 20rpx;
  background: #F7FAFC;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.6;
  white-space: pre-wrap;
}

.kv-value.muted {
  color: var(--color-text-secondary);
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 0 16rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #EDF2F7;
}

.image-thumb {
  width: 100%;
  height: 100%;
}

.image-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 6rpx 0;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
}

.action-bar {
  margin-top: 12rpx;
}

.action-btn {
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.action-btn[disabled] {
  opacity: 0.45;
}

.action-hint {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
