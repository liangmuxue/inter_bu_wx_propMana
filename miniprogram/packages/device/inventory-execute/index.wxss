.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 40rpx;
}

.head-card {
  margin: 24rpx 32rpx 0;
  padding: 28rpx;
  background: #fff;
  border-radius: var(--radius);
  border: 1rpx solid var(--color-border);
}

.head-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.head-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
}

.head-meta {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.kv-row {
  display: flex;
  gap: 16rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.kv-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.kv-label {
  flex: 0 0 200rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.kv-value {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--color-text);
  line-height: 1.45;
  word-break: break-all;
}

.kv-value.link {
  color: var(--color-primary);
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx 0;
}

.search-input {
  flex: 1;
  height: 68rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius);
  font-size: 26rpx;
}

.tool-btn {
  margin: 0;
  padding: 0 22rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 26rpx;
  background: #fff;
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius);
}

.tool-btn.primary {
  background: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
}

.meta-bar {
  padding: 12rpx 32rpx 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.item-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #F1F5F9;
}

.action-link {
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--color-primary);
  font-size: 26rpx;
  line-height: 1.4;
  border: none;
}

.action-link.danger {
  color: #E53E3E;
}

.action-link::after {
  border: none;
}

.sheet-kv {
  display: flex;
  gap: 16rpx;
  padding: 6rpx 0;
}

.sheet-kv-label {
  flex: 0 0 140rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.sheet-kv-value {
  flex: 1;
  font-size: 24rpx;
  color: var(--color-text);
  word-break: break-all;
}

.req {
  color: #E53E3E;
}

.view-only-tip {
  margin: 16rpx 32rpx 0;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: #975A16;
  background: #FFFAF0;
  border-radius: var(--radius);
  line-height: 1.4;
}

.scan-bar {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx 8rpx;
}

.scan-btn {
  flex: 1;
  margin: 0;
  background: var(--color-primary);
  color: #fff;
  font-size: 28rpx;
  border-radius: var(--radius);
  line-height: 2.2;
}

.scan-btn.nfc {
  background: #2B6CB0;
}

.action-bar {
  padding: 8rpx 32rpx 0;
}

.surplus-btn {
  margin: 0;
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: var(--color-primary);
  background: #fff;
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius);
}

.surplus-btn::after {
  border: none;
}

.filter-bar {
  white-space: nowrap;
}

.filter-inner {
  display: inline-flex;
  padding: 8rpx 32rpx 16rpx;
  gap: 16rpx;
}

.filter-item {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: #fff;
  border-radius: 999rpx;
  border: 1rpx solid var(--color-border);
}

.filter-item.active {
  color: var(--color-primary);
  border-color: var(--color-primary);
  background: #EBF4FF;
  font-weight: 600;
}

.item-head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.item-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
}

.item-card .kv-label {
  flex-basis: 180rpx;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
}

.sheet-close {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.sheet-asset {
  padding: 20rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
  margin-bottom: 24rpx;
}

.sheet-asset-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.sheet-asset-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.form-field {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #4A5568;
}

.form-picker {
  padding: 20rpx 24rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
  border: 1rpx solid var(--color-border);
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background: #F7FAFC;
  border-radius: var(--radius);
  border: 1rpx solid var(--color-border);
  font-size: 28rpx;
}

.submit-btn {
  margin-top: 8rpx;
}

.kv-row--images {
  align-items: flex-start;
}

.inv-thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.inv-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 8rpx;
  background: #EDF2F7;
}

.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.upload-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
}

.upload-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  background: #EDF2F7;
}

.upload-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
}

.upload-add {
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  text-align: center;
  font-size: 56rpx;
  color: #A0AEC0;
  background: #F7FAFC;
  border: 1rpx dashed var(--color-border);
  border-radius: 8rpx;
  box-sizing: border-box;
}
