.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.head-card,
.stat-bar,
.item-card {
  margin-bottom: 20rpx;
}

.head-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 8rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.head-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
}

.kv-row {
  display: flex;
  gap: 16rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.kv-row:last-child {
  border-bottom: none;
}

.kv-label {
  flex: 0 0 160rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.kv-value {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--color-text);
  word-break: break-all;
}

.stat-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 8rpx;
}

.stat-item {
  flex: 1 1 28%;
  min-width: 140rpx;
  text-align: center;
  padding: 12rpx 8rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
}

.stat-item.warn .stat-val {
  color: #D69E2E;
}

.stat-item.danger .stat-val {
  color: #E53E3E;
}

.stat-item.info .stat-val {
  color: #3182CE;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 4rpx;
}

.stat-val {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.search-bar {
  margin-bottom: 16rpx;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 12rpx 8rpx 20rpx;
  background: #fff;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius);
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  margin: 0;
  font-size: 26rpx;
  color: var(--color-text);
  background: transparent;
}

.search-icon-btn {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-search {
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid var(--color-primary);
  border-radius: 50%;
  box-sizing: border-box;
  position: relative;
}

.icon-search::after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 4rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
  right: -8rpx;
  bottom: -2rpx;
  transform: rotate(45deg);
  transform-origin: center;
}

.icon-reset {
  width: 22rpx;
  height: 22rpx;
  position: relative;
}

.icon-reset::before,
.icon-reset::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 3rpx;
  background: var(--color-text-secondary);
  border-radius: 2rpx;
}

.icon-reset::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.icon-reset::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.filter-bar {
  margin: 0 -24rpx 8rpx;
  white-space: nowrap;
}

.filter-inner {
  display: inline-flex;
  padding: 0 24rpx 12rpx;
  gap: 12rpx;
}

.filter-item {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: #fff;
  border-radius: 999rpx;
  border: 1rpx solid var(--color-border);
}

.filter-item.active {
  color: #fff;
  background: var(--color-primary);
  border-color: var(--color-primary);
  font-weight: 600;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin: 8rpx 8rpx 16rpx;
  color: var(--color-text);
}

.item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.item-code {
  font-size: 24rpx;
  color: var(--color-primary);
}

.item-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.kv-row--images {
  align-items: flex-start;
}

.inv-thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.inv-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 8rpx;
  background: #EDF2F7;
}

.empty {
  text-align: center;
  padding: 48rpx 24rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}
