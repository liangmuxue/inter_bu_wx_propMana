<view class="page">
  <view class="scope-bar">
    <view
      class="scope-item {{scope === 'org' ? 'active' : ''}}"
      bindtap="onScopeChange"
      data-scope="org"
    >组织权限内</view>
    <view
      class="scope-item {{scope === 'mine' ? 'active' : ''}}"
      bindtap="onScopeChange"
      data-scope="mine"
    >我的申请</view>
    <view class="filter-trigger {{queryActive ? 'active' : ''}}" bindtap="openFilterPanel">
      <text class="filter-icon">筛选</text>
      <text wx:if="{{queryActive}}" class="filter-dot"></text>
    </view>
  </view>

  <view class="filter-bar-wrap">
    <scroll-view scroll-x class="filter-bar" show-scrollbar="{{false}}">
      <view class="filter-inner">
        <view
          wx:for="{{statusFilters}}"
          wx:key="id"
          class="filter-item {{status === item.id ? 'active' : ''}}"
          bindtap="onStatusChange"
          data-status="{{item.id}}"
        >{{item.label}}</view>
        <view class="filter-tail"></view>
      </view>
    </scroll-view>
  </view>

  <view class="query-summary" wx:if="{{queryActive}}">
    <text>已启用查询筛选</text>
    <text class="query-reset" bindtap="resetQuery">清除</text>
  </view>

  <scroll-view
    class="list-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="container">
      <view
        wx:for="{{list}}"
        wx:key="id"
        class="card item-card"
        bindtap="openDetail"
        data-id="{{item.id}}"
      >
        <view class="item-head">
          <text class="item-code">{{item.code}}</text>
          <text class="tag {{item.statusClass}}">{{item.status}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">物料编码</text>
          <text class="kv-value">{{item.spareCode}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">物料名称</text>
          <text class="kv-value">{{item.spareName}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">领用数量</text>
          <text class="kv-value">{{item.qtyText}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">申请人</text>
          <text class="kv-value">{{item.applicantDisplay}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">领用组织</text>
          <text class="kv-value">{{item.useOrgNameText}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">领用区域</text>
          <text class="kv-value">{{item.useRegionNameText}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">申请时间</text>
          <text class="kv-value">{{item.createdAt}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-label">申请备注</text>
          <text class="kv-value kv-desc">{{item.remarkText}}</text>
        </view>
        <view class="action-row" wx:if="{{item.hasActions}}" catchtap="preventBubble">
          <button
            wx:if="{{item.canView}}"
            class="action-btn"
            catchtap="openDetail"
            data-id="{{item.id}}"
          >查看</button>
          <button
            wx:if="{{item.canApprove}}"
            class="action-btn primary"
            catchtap="onApprove"
            data-id="{{item.id}}"
          >审批</button>
        </view>
      </view>
      <view wx:if="{{!loading && !list.length}}" class="empty">暂无领用记录</view>
    </view>
  </scroll-view>

  <view class="footer-bar" wx:if="{{canAdd}}">
    <button class="btn-create" bindtap="goCreate">领用申请</button>
  </view>

  <view wx:if="{{showFilterPanel}}" class="filter-mask" bindtap="closeFilterPanel" catchtouchmove="preventClose">
    <view class="filter-panel" catchtap="preventClose" catchtouchmove="preventClose">
      <view class="filter-panel-hd">
        <text class="filter-panel-title">查询条件</text>
        <text class="filter-panel-close" bindtap="closeFilterPanel">关闭</text>
      </view>
      <view class="filter-field">
        <text class="filter-label">关键词</text>
        <view class="filter-input-wrap">
          <input
            class="filter-input"
            placeholder="申请单号/物料/申请人/组织/备注"
            placeholder-class="filter-input-placeholder"
            value="{{queryForm.keyword}}"
            bindinput="onQueryKeywordInput"
            confirm-type="search"
            bindconfirm="applyQuery"
          />
        </view>
      </view>
      <view class="filter-actions">
        <button class="btn-reset" bindtap="resetQuery">重置</button>
        <button class="btn-query" bindtap="applyQuery">查询</button>
      </view>
    </view>
  </view>
</view>
