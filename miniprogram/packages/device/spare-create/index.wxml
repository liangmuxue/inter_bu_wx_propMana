<view class="page">
  <view class="container">
    <view class="card">
      <view class="card-title">选择物料 <text class="req">*</text></view>
      <text class="form-hint">仅展示当前账号组织数据权限内、且可用库存大于 0 的物料</text>
      <view class="form-field">
        <picker mode="selector" range="{{spareOptions}}" range-key="label" value="{{spareIndex}}" bindchange="onSparePick">
          <view class="form-picker">{{spare ? spare.label : (spareOptions.length ? '请选择物料' : '暂无可领用物料')}}</view>
        </picker>
      </view>
      <view wx:if="{{spare}}" class="spare-box">
        <view class="kv-row"><text class="kv-label">物料编码</text><text class="kv-value">{{spare.code}}</text></view>
        <view class="kv-row"><text class="kv-label">物料名称</text><text class="kv-value">{{spare.name}}</text></view>
        <view class="kv-row"><text class="kv-label">分类</text><text class="kv-value">{{spare.categoryName || '—'}}</text></view>
        <view class="kv-row"><text class="kv-label">品牌 / 型号</text><text class="kv-value">{{spare.brand || '—'}} / {{spare.model || '—'}}</text></view>
        <view class="kv-row"><text class="kv-label">所属组织</text><text class="kv-value">{{spare.orgName || '—'}}</text></view>
        <view class="kv-row"><text class="kv-label">存放区域</text><text class="kv-value">{{spare.regionName || '—'}}</text></view>
        <view class="kv-row"><text class="kv-label">存放位置</text><text class="kv-value">{{spare.location || '—'}}</text></view>
        <view class="kv-row"><text class="kv-label">可用库存</text><text class="kv-value accent">{{spare.availableStock}} {{spare.unit}}</text></view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">领用信息</view>
      <view class="kv-row">
        <text class="kv-label">申请单号</text>
        <text class="kv-value muted">{{codeHint}}</text>
      </view>
      <view class="kv-row">
        <text class="kv-label">申请人</text>
        <text class="kv-value">{{applicantDisplay}}</text>
      </view>
      <view class="form-field">
        <text class="form-label">领用组织</text>
        <picker mode="selector" range="{{orgOptions}}" range-key="name" value="{{orgIndex}}" bindchange="onOrgPick">
          <view class="form-picker">{{orgName || '请选择领用组织'}}</view>
        </picker>
      </view>
      <view class="form-field">
        <text class="form-label">领用区域</text>
        <picker mode="selector" range="{{regionOptions}}" range-key="name" value="{{regionIndex}}" bindchange="onRegionPick">
          <view class="form-picker">{{regionName || '请选择领用区域'}}</view>
        </picker>
      </view>
      <view class="form-field">
        <text class="form-label">领用数量 <text class="req">*</text></text>
        <input
          class="form-input"
          type="number"
          placeholder="请输入领用数量"
          value="{{qty}}"
          bindinput="onQtyInput"
        />
        <text class="form-hint" wx:if="{{stockHint}}">{{stockHint}}</text>
      </view>
      <view class="form-field">
        <text class="form-label">申请备注</text>
        <textarea
          class="form-textarea"
          maxlength="200"
          placeholder="选填，可说明领用用途"
          value="{{remark}}"
          bindinput="onRemarkInput"
        />
      </view>
    </view>

    <button class="btn-submit" bindtap="onSubmit" loading="{{submitting}}">提交申请</button>
  </view>
</view>
