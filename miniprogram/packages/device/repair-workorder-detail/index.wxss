.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.hero-name {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-all;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.kv-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
}

.kv-row:last-child {
  border-bottom: none;
}

.kv-label {
  flex-shrink: 0;
  width: 180rpx;
  font-size: 26rpx;
  color: #718096;
}

.kv-value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: var(--color-text);
  word-break: break-all;
}

.kv-value.highlight {
  color: var(--color-primary);
  font-weight: 600;
}

.kv-value.link {
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

.timeline {
  margin-top: 8rpx;
}

.timeline-item {
  display: flex;
  gap: 20rpx;
  position: relative;
}

.timeline-axis {
  width: 24rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.timeline-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  background: var(--color-primary);
}

.timeline-dot.tone-pass { background: var(--color-success); }
.timeline-dot.tone-reject { background: var(--color-danger); }
.timeline-dot.tone-rectify { background: var(--color-warning); }
.timeline-dot.tone-discover { background: var(--color-primary); }

.timeline-line {
  flex: 1;
  width: 2rpx;
  margin-top: 8rpx;
  background: #E2E8F0;
  min-height: 40rpx;
}

.timeline-body {
  flex: 1;
  min-width: 0;
  padding-bottom: 28rpx;
}

.timeline-time {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.timeline-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.timeline-stage {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.timeline-operator {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.timeline-remark {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.45;
}

.timeline-content {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
}

.timeline-content-label {
  display: block;
  font-size: 22rpx;
  color: #718096;
  margin-bottom: 6rpx;
}

.timeline-content-text {
  display: block;
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.5;
  white-space: pre-wrap;
}

.media-block {
  margin-top: 16rpx;
}

.media-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #718096;
}

.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.upload-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius);
  overflow: hidden;
  background: #EDF2F7;
}

.upload-thumb {
  width: 100%;
  height: 100%;
}

.upload-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 4rpx 0;
  font-size: 18rpx;
  text-align: center;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
}

.video-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
  padding: 20rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
}

.video-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: 24rpx;
  flex-shrink: 0;
}

.video-info {
  flex: 1;
  min-width: 0;
}

.video-name {
  display: block;
  font-size: 28rpx;
  color: var(--color-text);
  word-break: break-all;
}

.video-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.timeline-empty {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.empty {
  padding: 120rpx 32rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 28rpx;
}
