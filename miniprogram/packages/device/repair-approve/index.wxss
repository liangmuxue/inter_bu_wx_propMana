.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.hero-code {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: flex-end;
}

.hero-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.hero-meta {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.kv-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
}

.kv-row:last-child {
  border-bottom: none;
}

.kv-label {
  flex-shrink: 0;
  width: 160rpx;
  font-size: 26rpx;
  color: #718096;
}

.kv-value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: var(--color-text);
  word-break: break-all;
}

.kv-desc {
  text-align: left;
  line-height: 1.45;
}

.desc-box {
  padding: 20rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-text);
  white-space: pre-wrap;
}

.media-block {
  margin-top: 20rpx;
}

.media-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #718096;
}

.media-empty {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.upload-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius);
  overflow: hidden;
  background: #EDF2F7;
}

.upload-thumb {
  width: 100%;
  height: 100%;
}

.upload-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 4rpx 0;
  font-size: 18rpx;
  text-align: center;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
}

.video-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
}

.video-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: 24rpx;
}

.video-info {
  flex: 1;
  min-width: 0;
}

.video-name {
  display: block;
  font-size: 28rpx;
  color: var(--color-text);
}

.video-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.form-hint {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.form-field {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.req {
  color: var(--color-danger);
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.45;
  background: #F7FAFC;
  border-radius: var(--radius);
}

.choose-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-pass,
.btn-reject,
.btn-primary,
.btn-secondary,
.btn-danger {
  margin: 0;
  font-size: 28rpx;
  line-height: 2.4;
  border-radius: var(--radius);
}

.btn-pass,
.btn-primary {
  background: var(--color-primary);
  color: #fff;
}

.btn-reject,
.btn-danger {
  background: #FFF5F5;
  color: #E53E3E;
}

.btn-secondary {
  background: #EDF2F7;
  color: var(--color-text);
}

.btn-pass::after,
.btn-reject::after,
.btn-primary::after,
.btn-secondary::after,
.btn-danger::after {
  border: none;
}

.worker-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.worker-tree {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.worker-org-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
}

.worker-empty {
  padding: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: #F7FAFC;
  border-radius: var(--radius);
}

.worker-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
  border: 2rpx solid transparent;
}

.worker-item.checked {
  background: #EBF4FF;
  border-color: var(--color-primary);
}

.check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #CBD5E0;
  box-sizing: border-box;
  flex-shrink: 0;
  background: #fff;
}

.check.on {
  border-color: var(--color-primary);
  background: var(--color-primary);
  position: relative;
}

.check.on::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 4rpx;
  width: 10rpx;
  height: 18rpx;
  border: 4rpx solid #fff;
  border-top: 0;
  border-left: 0;
  transform: rotate(45deg);
}

.worker-info {
  flex: 1;
  min-width: 0;
}

.worker-name {
  display: block;
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}

.worker-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.selected-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-primary);
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.form-actions button {
  flex: 1;
}

.empty {
  padding: 120rpx 32rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.reject-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.reject-dialog {
  width: 100%;
  max-width: 620rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.reject-title {
  padding: 36rpx 32rpx 16rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text);
}

.reject-field {
  padding: 8rpx 32rpx 24rpx;
}

.reject-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.reject-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.45;
  background: #F7FAFC;
  border-radius: var(--radius);
}

.reject-footer {
  display: flex;
  border-top: 1rpx solid var(--color-border);
}

.reject-btn {
  flex: 1;
  margin: 0;
  padding: 0;
  font-size: 32rpx;
  line-height: 96rpx;
  background: #fff;
  border-radius: 0;
}

.reject-btn::after {
  border: none;
}

.reject-btn.cancel {
  color: var(--color-text);
  border-right: 1rpx solid var(--color-border);
}

.reject-btn.confirm {
  color: var(--color-primary);
  font-weight: 600;
}
