<view class="page" wx:if="{{order}}">
  <!-- 同 PC：验收弹窗内嵌完整工单详情 -->
  <view class="hero card">
    <view class="hero-top">
      <text class="hero-name">{{order.assetNameText}}</text>
      <text class="tag {{order.statusClass}}">{{order.status}}</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">工单信息</view>
    <view class="kv-row"><text class="kv-label">工单编号</text><text class="kv-value">{{order.code || '—'}}</text></view>
    <view class="kv-row"><text class="kv-label">报修单号</text><text class="kv-value">{{order.requestCodeText}}</text></view>
    <view class="kv-row"><text class="kv-label">资产编号</text><text class="kv-value">{{order.assetCodeText}}</text></view>
    <view class="kv-row"><text class="kv-label">资产名称</text><text class="kv-value">{{order.assetNameText}}</text></view>
    <view class="kv-row"><text class="kv-label">派单时间</text><text class="kv-value">{{order.dispatchTimeText}}</text></view>
    <view class="kv-row"><text class="kv-label">指派维修人</text><text class="kv-value">{{order.assigneesText}}</text></view>
  </view>

  <view class="card">
    <view class="section-title">维修执行</view>
    <view class="kv-row"><text class="kv-label">维修执行人</text><text class="kv-value">{{order.executorNameText}}</text></view>
    <view class="kv-row"><text class="kv-label">维修完成时间</text><text class="kv-value">{{order.finishTimeText}}</text></view>
  </view>

  <view class="card" wx:if="{{order.showVoidSection}}">
    <view class="section-title">作废信息</view>
    <view class="kv-row"><text class="kv-label">作废人</text><text class="kv-value">{{order.voidByNameText}}</text></view>
    <view class="kv-row"><text class="kv-label">作废时间</text><text class="kv-value">{{order.voidTimeText}}</text></view>
  </view>

  <view class="card">
    <view class="section-title">流程记录</view>
    <view class="timeline" wx:if="{{order.timeline.length}}">
      <view
        wx:for="{{order.timeline}}"
        wx:key="key"
        wx:for-index="idx"
        class="timeline-item"
      >
        <view class="timeline-axis">
          <view class="timeline-dot tone-{{item.dotTone}}"></view>
          <view wx:if="{{idx < order.timeline.length - 1}}" class="timeline-line"></view>
        </view>
        <view class="timeline-body">
          <text class="timeline-time">{{item.time || '—'}}</text>
          <view class="timeline-head">
            <text class="timeline-stage">{{item.stage || '—'}}</text>
            <text class="tag {{item.resultClass}}">{{item.result || '—'}}</text>
          </view>
          <text class="timeline-operator">{{item.operatorDisplay}}</text>
          <text class="timeline-remark" wx:if="{{item.remarkText}}">{{item.remarkText}}</text>
          <view class="timeline-content" wx:if="{{item.hasContent}}">
            <text class="timeline-content-label">{{item.contentLabel || '说明'}}</text>
            <text class="timeline-content-text">{{item.contentText}}</text>
          </view>
          <view class="media-block" wx:if="{{item.hasImages}}">
            <text class="media-label">{{item.imageLabel || '图片'}}</text>
            <view class="upload-grid">
              <view
                wx:for="{{item.displayImages}}"
                wx:for-item="img"
                wx:for-index="imgIdx"
                wx:key="src"
                class="upload-item readonly"
                bindtap="previewTimelineImage"
                data-node-index="{{idx}}"
                data-img-index="{{imgIdx}}"
              >
                <image class="upload-thumb" src="{{img.src}}" mode="aspectFill" />
                <text class="upload-tip">点击查看</text>
              </view>
            </view>
          </view>
          <view class="media-block" wx:if="{{item.hasVideos}}">
            <text class="media-label">{{item.attachmentLabel || '附件'}}</text>
            <view
              wx:for="{{item.displayVideos}}"
              wx:for-item="vid"
              wx:for-index="vidIdx"
              wx:key="url"
              class="video-entry"
              bindtap="playTimelineVideo"
              data-node-index="{{idx}}"
              data-vid-index="{{vidIdx}}"
            >
              <view class="video-icon">▶</view>
              <view class="video-info">
                <text class="video-name">{{vid.name}}</text>
                <text class="video-hint">点击播放</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <text class="timeline-empty" wx:else>暂无流程记录</text>
  </view>

  <!-- 同 PC：验收意见* + 验收图片 + 验收附件 -->
  <view class="card form-card">
    <view class="section-title">验收操作</view>
    <view class="form-field">
      <text class="form-label">验收意见 <text class="req">*</text></text>
      <textarea
        class="form-textarea"
        placeholder="请填写验收意见"
        maxlength="200"
        value="{{acceptOpinion}}"
        bindinput="onOpinionInput"
      />
    </view>

    <view class="form-field">
      <view class="field-head">
        <text class="form-label">验收图片</text>
        <text class="form-hint">选填，最多 {{maxImages}} 张，点击缩略图查看大图</text>
      </view>
      <view class="upload-grid">
        <view wx:for="{{acceptImages}}" wx:key="path" class="upload-item">
          <image
            class="upload-thumb"
            src="{{item.path}}"
            mode="aspectFill"
            bindtap="previewImage"
            data-index="{{index}}"
          />
          <text class="upload-remove" catchtap="removeImage" data-index="{{index}}">×</text>
        </view>
        <view
          wx:if="{{acceptImages.length < maxImages}}"
          class="upload-add"
          bindtap="chooseImages"
        >
          <text class="upload-add-icon">+</text>
          <text class="upload-add-text">上传图片</text>
        </view>
      </view>
    </view>

    <view class="form-field last">
      <text class="form-label">验收附件</text>
      <text class="form-hint">选填，可上传视频（mp4 / mov / avi）</text>
      <button class="tool-btn" bindtap="chooseVideo" wx:if="{{!videoAttachment}}">上传视频</button>
      <view class="video-row" wx:if="{{videoAttachment}}">
        <text class="video-file-name">{{videoAttachment.name}}</text>
        <text class="link" bindtap="removeVideo">删除</text>
      </view>
    </view>
  </view>

  <view class="footer-bar">
    <button class="btn-secondary" bindtap="onCancel">取消</button>
    <button class="btn-danger" bindtap="submitReject" loading="{{submitting}}">验收驳回</button>
    <button class="btn-primary" bindtap="submitPass" loading="{{submitting}}">验收通过</button>
  </view>
</view>

<view class="empty" wx:if="{{loading}}">加载中…</view>
<view class="empty" wx:if="{{!loading && notFound}}">未找到待验收工单，或无权操作</view>
