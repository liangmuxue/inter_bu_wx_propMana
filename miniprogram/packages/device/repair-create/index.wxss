.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 48rpx;
}

.scan-bar {
  display: flex;
  gap: 16rpx;
  margin: 8rpx 0 20rpx;
}

.scan-btn {
  flex: 1;
  margin: 0;
  background: var(--color-primary);
  color: #fff;
  font-size: 26rpx;
  border-radius: var(--radius);
  line-height: 2.2;
}

.scan-btn.nfc {
  background: #2B6CB0;
}

.req {
  color: var(--color-danger);
}

.kv-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
}

.kv-row:last-child {
  border-bottom: none;
}

.kv-label {
  flex-shrink: 0;
  width: 160rpx;
  font-size: 26rpx;
  color: #718096;
}

.kv-value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: var(--color-text);
  word-break: break-all;
}

.kv-value.muted {
  color: var(--color-text-secondary);
}

.asset-box {
  margin-top: 8rpx;
  padding: 8rpx 20rpx 16rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
}

.asset-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 8rpx;
  padding-top: 8rpx;
}

.link {
  display: inline-block;
  margin-top: 8rpx;
  color: var(--color-primary);
  font-size: 26rpx;
}

.link.muted {
  color: var(--color-text-secondary);
}

.form-field {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #4A5568;
}

.form-picker {
  padding: 20rpx 24rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
  border: 1rpx solid var(--color-border);
}

.form-picker.flex {
  flex: 1;
}

.datetime-row {
  display: flex;
  gap: 16rpx;
}

.datetime-row picker {
  flex: 1;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background: #F7FAFC;
  border-radius: var(--radius);
  border: 1rpx solid var(--color-border);
  font-size: 28rpx;
}

.form-hint {
  display: block;
  margin: 8rpx 0 12rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.upload-item,
.upload-add {
  position: relative;
  width: 152rpx;
  height: 152rpx;
  border-radius: var(--radius);
  overflow: hidden;
}

.upload-thumb {
  width: 100%;
  height: 100%;
  background: #EDF2F7;
}

.upload-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
}

.upload-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed var(--color-border);
  background: #F7FAFC;
  color: var(--color-text-secondary);
}

.upload-add-icon {
  font-size: 40rpx;
  line-height: 1;
}

.upload-add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.tool-btn {
  margin: 0;
  background: #EDF2F7;
  color: var(--color-text);
  font-size: 26rpx;
  border-radius: var(--radius);
  line-height: 2.1;
}

.video-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
}

.video-name {
  font-size: 26rpx;
  color: var(--color-text);
}

.submit-btn {
  margin-top: 8rpx;
}
