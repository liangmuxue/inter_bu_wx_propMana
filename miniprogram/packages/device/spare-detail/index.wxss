.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.hero-code {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.hero-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.hero-meta {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.kv-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
}

.kv-row:last-child {
  border-bottom: none;
}

.kv-label {
  flex-shrink: 0;
  width: 160rpx;
  font-size: 26rpx;
  color: #718096;
}

.kv-value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: var(--color-text);
  word-break: break-all;
}

.kv-value.link {
  color: var(--color-primary);
}

.remark-label {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #718096;
}

.desc-box {
  margin-top: 8rpx;
  padding: 16rpx 20rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--color-text);
  word-break: break-all;
}

.pending-tip {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.action-bar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
}

.btn-primary,
.btn-danger {
  margin: 0;
  font-size: 30rpx;
  border-radius: var(--radius);
  line-height: 2.4;
}

.btn-primary {
  background: var(--color-primary);
  color: #fff;
}

.btn-danger {
  background: #FFF5F5;
  color: #E53E3E;
}

.btn-primary::after,
.btn-danger::after {
  border: none;
}

.empty {
  padding: 120rpx 24rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}
