.page {
  min-height: 100vh;
  background: var(--color-bg);
}

.sticky-filters {
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--color-bg);
}

.scope-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--color-border);
  align-items: center;
}

.scope-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  background: #F7FAFC;
  border-radius: var(--radius);
  line-height: 1.2;
}

.scope-item.active {
  color: var(--color-primary);
  background: #EBF4FF;
  font-weight: 600;
}

.filter-trigger {
  flex-shrink: 0;
  position: relative;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: #F7FAFC;
  border-radius: var(--radius);
}

.filter-trigger.active {
  color: var(--color-primary);
  background: #EBF4FF;
  font-weight: 600;
}

.filter-dot {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E53E3E;
}

.filter-bar-wrap {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  background: #fff;
  border-bottom: 1rpx solid var(--color-border);
  box-sizing: border-box;
  overflow: hidden;
}

.filter-bar {
  width: 100%;
  height: 88rpx;
  white-space: nowrap;
}

.filter-inner {
  display: inline-block;
  padding: 16rpx 0 16rpx 24rpx;
  white-space: nowrap;
  height: 88rpx;
  box-sizing: border-box;
}

.filter-item {
  display: inline-block;
  vertical-align: middle;
  margin-right: 16rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: #F7FAFC;
  border-radius: 999rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.filter-item.active {
  color: #fff;
  background: var(--color-primary);
  font-weight: 600;
}

.filter-tail {
  display: inline-block;
  width: 24rpx;
  height: 1rpx;
  vertical-align: middle;
}

.query-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: #F7FAFC;
  border-bottom: 1rpx solid var(--color-border);
}

.query-reset {
  color: var(--color-primary);
}

.filter-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}

.filter-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.filter-panel-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.filter-panel-title {
  font-size: 32rpx;
  font-weight: 600;
}

.filter-panel-close {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.filter-field {
  margin-bottom: 24rpx;
}

.filter-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.filter-picker {
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
  line-height: 1.4;
  min-height: 88rpx;
  box-sizing: border-box;
}

.filter-input-wrap {
  width: 100%;
  min-height: 88rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
  box-sizing: border-box;
  overflow: hidden;
}

.filter-input {
  display: block;
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  line-height: 1.4;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--color-text);
  background: transparent;
}

.filter-input-placeholder {
  color: #A0AEC0;
  font-size: 26rpx;
}

.filter-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 8rpx;
}

.btn-reset,
.btn-query {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
}

.btn-reset {
  background: #EDF2F7;
  color: var(--color-text);
}

.btn-query {
  background: var(--color-primary);
  color: #fff;
}

.task-card {
  margin-bottom: 20rpx;
}

.task-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 8rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.task-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
}

.kv-row {
  display: flex;
  gap: 16rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.kv-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.kv-label {
  flex: 0 0 240rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.kv-value {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--color-text);
  line-height: 1.45;
  word-break: break-all;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.action-btn {
  flex: 1;
  margin: 0;
  padding: 0;
  font-size: 26rpx;
  line-height: 2.2;
  color: var(--color-primary);
  background: #EBF4FF;
  border-radius: var(--radius);
  border: none;
}

.action-btn.primary {
  color: #fff;
  background: var(--color-primary);
}

.action-btn::after {
  border: none;
}
