<view class="page">
  <view class="sticky-filters">
    <view class="scope-bar">
      <view
        class="scope-item {{scope === 'org' ? 'active' : ''}}"
        bindtap="onScopeChange"
        data-scope="org"
      >组织盘点</view>
      <view
        class="scope-item {{scope === 'mine' ? 'active' : ''}}"
        bindtap="onScopeChange"
        data-scope="mine"
      >我的盘点</view>
      <view class="filter-trigger {{queryActive ? 'active' : ''}}" bindtap="openFilterPanel">
        <text class="filter-icon">筛选</text>
        <text wx:if="{{queryActive}}" class="filter-dot"></text>
      </view>
    </view>

    <view class="filter-bar-wrap">
      <scroll-view scroll-x class="filter-bar" show-scrollbar="{{false}}">
        <view class="filter-inner">
          <view
            wx:for="{{statusFilters}}"
            wx:key="id"
            class="filter-item {{status === item.id ? 'active' : ''}}"
            bindtap="onStatusChange"
            data-status="{{item.id}}"
          >{{item.label}}</view>
          <view class="filter-tail"></view>
        </view>
      </scroll-view>
    </view>

    <view class="query-summary" wx:if="{{queryActive}}">
      <text>已启用查询筛选</text>
      <text class="query-reset" bindtap="resetQuery">清除</text>
    </view>
  </view>

  <view class="container">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="card task-card"
    >
      <view class="task-head">
        <text class="task-name">{{item.name}}</text>
        <text class="tag {{item.statusClass}}">{{item.status}}</text>
      </view>
      <view class="kv-row">
        <text class="kv-label">盘点单号</text>
        <text class="kv-value">{{item.code}}</text>
      </view>
      <view class="kv-row">
        <text class="kv-label">计划开始日期</text>
        <text class="kv-value">{{item.planStartDate || item.planDate || '—'}}</text>
      </view>
      <view class="kv-row">
        <text class="kv-label">计划结束日期</text>
        <text class="kv-value">{{item.planEndDate || '—'}}</text>
      </view>
      <view class="kv-row">
        <text class="kv-label">盘点人</text>
        <text class="kv-value">{{item.countersText}}</text>
      </view>
      <view class="kv-row">
        <text class="kv-label">盘点进度</text>
        <text class="kv-value">{{item.progressText}}</text>
      </view>
      <view class="kv-row">
        <text class="kv-label">完成时间</text>
        <text class="kv-value">{{item.completedAtText}}</text>
      </view>
      <view class="kv-row">
        <text class="kv-label">创建人</text>
        <text class="kv-value">{{item.creatorName}}</text>
      </view>
      <view class="kv-row">
        <text class="kv-label">创建时间</text>
        <text class="kv-value">{{item.createdAt}}</text>
      </view>
      <view class="kv-row">
        <text class="kv-label">备注</text>
        <text class="kv-value">{{item.remark || '—'}}</text>
      </view>
      <view class="kv-row">
        <text class="kv-label">盘点范围（所属组织）</text>
        <text class="kv-value">{{item.scopeFields.org}}</text>
      </view>
      <view class="kv-row">
        <text class="kv-label">盘点范围（所属区域）</text>
        <text class="kv-value">{{item.scopeFields.region}}</text>
      </view>
      <view class="kv-row">
        <text class="kv-label">盘点范围（资产分类）</text>
        <text class="kv-value">{{item.scopeFields.category}}</text>
      </view>
      <view class="kv-row">
        <text class="kv-label">盘点范围（资产状态）</text>
        <text class="kv-value">{{item.scopeFields.status}}</text>
      </view>
      <view class="kv-row">
        <text class="kv-label">盘点范围（购置方式）</text>
        <text class="kv-value">{{item.scopeFields.purchaseMethod}}</text>
      </view>
      <view class="action-row" wx:if="{{item.canExecute || item.canViewDetail || item.canViewReport || item.canAuditReport}}">
        <button
          wx:if="{{item.canExecute}}"
          class="action-btn primary"
          catchtap="openExecute"
          data-id="{{item.id}}"
          data-can="{{item.canExecute}}"
        >去执行</button>
        <button
          wx:if="{{item.canViewDetail}}"
          class="action-btn"
          catchtap="openDetail"
          data-id="{{item.id}}"
          data-can="{{item.canViewDetail}}"
        >盘点明细</button>
        <button
          wx:if="{{item.canViewReport}}"
          class="action-btn"
          catchtap="openReport"
          data-id="{{item.id}}"
          data-can="{{item.canViewReport}}"
        >查看报告</button>
        <button
          wx:if="{{item.canAuditReport}}"
          class="action-btn"
          catchtap="openAudit"
          data-id="{{item.id}}"
          data-can="{{item.canAuditReport}}"
        >审核报告</button>
      </view>
    </view>
    <view wx:if="{{!loading && !list.length}}" class="empty">暂无{{scopeHint}}盘点单</view>
  </view>

  <view wx:if="{{showFilterPanel}}" class="filter-mask" bindtap="closeFilterPanel" catchtouchmove="preventClose">
    <view class="filter-panel" catchtap="preventClose" catchtouchmove="preventClose">
      <view class="filter-panel-hd">
        <text class="filter-panel-title">查询条件</text>
        <text class="filter-panel-close" bindtap="closeFilterPanel">关闭</text>
      </view>
      <view class="filter-field">
        <text class="filter-label">关键词</text>
        <view class="filter-input-wrap">
          <input
            class="filter-input"
            placeholder="盘点单号/清单名称/创建人/盘点人"
            placeholder-class="filter-input-placeholder"
            value="{{queryForm.keyword}}"
            bindinput="onQueryKeywordInput"
            confirm-type="search"
            bindconfirm="applyQuery"
          />
        </view>
      </view>
      <view class="filter-actions">
        <button class="btn-reset" bindtap="resetQuery">重置</button>
        <button class="btn-query" bindtap="applyQuery">查询</button>
      </view>
    </view>
  </view>
</view>
