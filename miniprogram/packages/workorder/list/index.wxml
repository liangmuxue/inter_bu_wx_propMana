<view class="page">
  <view class="scope-bar">
    <view class="scope-item {{tab === 'all' ? 'active' : ''}}" bindtap="onTabChange" data-tab="all">区域工单</view>
    <view class="scope-item {{tab === 'mine' ? 'active' : ''}}" bindtap="onTabChange" data-tab="mine">待我处理</view>
    <view class="filter-trigger {{queryActive ? 'active' : ''}}" bindtap="openFilterPanel">
      <text class="filter-icon">筛选</text>
      <text wx:if="{{queryActive}}" class="filter-dot"></text>
    </view>
  </view>

  <view class="filter-bar-wrap">
    <scroll-view scroll-x class="filter-bar" show-scrollbar="{{false}}">
      <view class="filter-inner">
        <view
          wx:for="{{statusFilters}}"
          wx:key="id"
          class="filter-item {{status === item.id ? 'active' : ''}}"
          bindtap="onStatusChange"
          data-status="{{item.id}}"
        >{{item.label}}</view>
        <view class="filter-tail"></view>
      </view>
    </scroll-view>
  </view>

  <view class="query-summary" wx:if="{{queryActive}}">
    <text class="query-summary-text">{{querySummaryText}}</text>
    <text class="query-reset" bindtap="resetQuery">清除</text>
  </view>

  <scroll-view
    class="list-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="container">
      <view wx:if="{{loading}}" class="empty card">加载中…</view>
      <block wx:elif="{{list.length}}">
        <view wx:for="{{list}}" wx:key="id" class="card item-card">
          <view bindtap="openDetail" data-id="{{item.id}}">
            <view class="item-head">
              <text class="item-code">{{item.id}}</text>
              <text class="tag {{item.statusClass}}">{{item.status}}</text>
            </view>
            <view class="item-content">{{item.content}}</view>
            <view class="kv-row">
              <text class="kv-label">工单分类</text>
              <text class="kv-value">{{item.categoryName || '—'}}</text>
            </view>
            <view class="kv-row">
              <text class="kv-label">上报区域</text>
              <text class="kv-value">{{item.regionName}}</text>
            </view>
            <view class="kv-row">
              <text class="kv-label">上报人</text>
              <text class="kv-value">{{item.starterName}} · {{item.starterOrg}}</text>
            </view>
            <view class="kv-row">
              <text class="kv-label">上报时间</text>
              <text class="kv-value">{{item.createdAt}}</text>
            </view>
            <view class="kv-row">
              <text class="kv-label">区域管理员</text>
              <text class="kv-value">{{item.dispatcherNamesText}}</text>
            </view>
            <view class="kv-row" wx:if="{{item.showHandlerField}}">
              <text class="kv-label">{{item.handlerFieldLabel}}</text>
              <text class="kv-value">{{item.handlerFieldValue}}</text>
            </view>
          </view>
          <view class="action-row" wx:if="{{item.canProcess}}">
            <button
              wx:for="{{item.actions}}"
              wx:for-item="act"
              wx:key="key"
              wx:if="{{act.key !== 'detail'}}"
              class="action-btn"
              size="mini"
              bindtap="onActionTap"
              data-id="{{item.id}}"
              data-action="{{act.key}}"
            >{{act.label}}</button>
          </view>
        </view>
      </block>
      <view wx:else class="empty card">
        <text>{{tab === 'mine' ? '当前账号暂无待我处理工单' : '暂无符合数据权限的工单'}}</text>
        <text class="empty-sub">{{tab === 'mine' ? '仅展示您作为区域管理员或指派执行人、且非本人上报的待处理工单；本人上报请至员工端「我的报事」' : '展示当前角色区域数据权限内、对应上报区域的全部工单'}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="filter-mask" wx:if="{{showFilterPanel}}" bindtap="closeFilterPanel"></view>
  <view class="filter-panel" wx:if="{{showFilterPanel}}" catchtap="preventClose">
    <view class="filter-panel-head">
      <text>筛选</text>
      <text class="filter-panel-close" bindtap="closeFilterPanel">关闭</text>
    </view>
    <view class="filter-panel-body">
      <view class="filter-field">
        <text class="filter-label">关键词</text>
        <view class="filter-input-wrap">
          <input
            class="filter-input"
            placeholder="编号/内容/上报人/区域"
            placeholder-class="filter-input-placeholder"
            value="{{queryForm.keyword}}"
            bindinput="onQueryKeywordInput"
          />
        </view>
      </view>
    </view>
    <view class="filter-panel-foot">
      <button class="btn ghost" bindtap="resetQuery">重置</button>
      <button class="btn primary" bindtap="applyQuery">确定</button>
    </view>
  </view>
</view>
