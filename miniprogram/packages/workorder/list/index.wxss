@import "../../../styles/workorder-list.wxss";

.item-content {
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.empty-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #A0AEC0;
  line-height: 1.5;
  word-break: normal;
  white-space: normal;
}

.filter-panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.filter-panel-close {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  font-weight: 400;
}

.filter-panel-body {
  margin-bottom: 24rpx;
}

.filter-field {
  margin-bottom: 0;
}

.filter-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
  white-space: nowrap;
}

.filter-input-wrap {
  width: 100%;
  min-height: 88rpx;
  background: #F7FAFC;
  border-radius: var(--radius);
  box-sizing: border-box;
  overflow: hidden;
}

.filter-input {
  display: block;
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  line-height: 1.4;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--color-text);
  background: transparent;
}

.filter-input-placeholder {
  color: #A0AEC0;
  font-size: 26rpx;
  line-height: 1.4;
}

.filter-panel-foot {
  display: flex;
  gap: 24rpx;
}

.filter-panel-foot .btn {
  flex: 1;
  margin: 0;
}
