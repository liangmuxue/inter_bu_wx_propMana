page {
  --color-primary: #1A5FDB;
  --color-success: #38A169;
  --color-warning: #DD6B20;
  --color-danger: #E53E3E;
  --color-text: #1A202C;
  --color-text-secondary: #718096;
  --color-bg: #F5F7FA;
  --color-border: #E2E8F0;
  --radius: 12rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background: var(--color-bg);
  box-sizing: border-box;
}

.container {
  padding: 24rpx 32rpx 48rpx;
}

.card {
  background: #fff;
  border-radius: var(--radius);
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--color-border);
  min-width: 0;
  overflow: hidden;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.btn-primary {
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius);
  font-size: 30rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.tag-info { background: #EBF4FF; color: var(--color-primary); }
.tag-success { background: #F0FFF4; color: var(--color-success); }
.tag-warning { background: #FFFAF0; color: var(--color-warning); }
.tag-danger { background: #FFF5F5; color: var(--color-danger); }
.tag-accent { background: #EBF8FF; color: #2b6cb0; }
.tag-violet { background: #FAF5FF; color: #6b46c1; }
.tag-primary { background: #EBF4FF; color: #1a5fdb; }
.tag-muted { background: #EDF2F7; color: #718096; }

/* 对齐员工端小程序2访客列表签到状态色 */
.status-tag {
  display: inline-block;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}

.status-tag.tone-green {
  background: #e6f7ed;
  color: var(--color-success);
}

.status-tag.tone-slate {
  background: #edf2f7;
  color: var(--color-text-secondary);
}

.status-tag.tone-blue {
  background: #e8f0fc;
  color: var(--color-primary);
}

.status-tag.tone-amber {
  background: #fff4e5;
  color: #c05621;
}

.status-tag.tone-red {
  background: #fff1f0;
  color: var(--color-danger);
}

.empty {
  text-align: center;
  padding: 80rpx 32rpx;
  color: var(--color-text-secondary);
}
