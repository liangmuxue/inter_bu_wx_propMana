.welcome-title {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}
.welcome-sub {
  font-size: 26rpx;
  color: #718096;
  margin-top: 8rpx;
  line-height: 1.4;
}
.module-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.module-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  flex-shrink: 0;
}
.module-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}
.module-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  display: block;
}
.entry-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
}
.entry-item {
  background: #F7FAFC;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius);
  padding: 24rpx 8rpx;
  text-align: center;
  overflow: hidden;
}
.entry-item:active {
  background: #EBF4FF;
  border-color: var(--color-primary);
}
.entry-name {
  font-size: 22rpx;
  color: var(--color-text);
  white-space: nowrap;
  display: block;
}
