.row-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.module-head-inline {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.module-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.module-title {
  font-size: 30rpx;
  font-weight: 600;
}

.link {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: normal;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx 12rpx;
  margin-top: 8rpx;
}

.stat-item {
  text-align: center;
  padding: 12rpx 4rpx;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
  display: block;
}

.stat-num.stat-danger {
  color: var(--color-danger);
}

.stat-label {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  display: block;
  line-height: 1.3;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: var(--color-text-secondary);
}
