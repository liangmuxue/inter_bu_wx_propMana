.form-group {
  margin-bottom: 32rpx;
}

.form-group:last-of-type {
  margin-bottom: 0;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #718096;
  line-height: 36rpx;
  margin-bottom: 16rpx;
}

.field-input-wrap {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid #E2E8F0;
  border-radius: 12rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: #fff;
}

.field-input {
  display: block;
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1A202C;
  background: transparent;
}

.field-placeholder {
  color: #A0AEC0;
  font-size: 28rpx;
}

.form-hint {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #E2E8F0;
  font-size: 24rpx;
  color: #718096;
  line-height: 1.6;
}

.submit-btn {
  margin-top: 16rpx;
  width: 100%;
}
