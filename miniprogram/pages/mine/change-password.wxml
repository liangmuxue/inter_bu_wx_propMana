<view class="container">
  <view class="card">
    <view class="form-group">
      <view class="field-label">原密码</view>
      <view class="field-input-wrap">
        <input class="field-input" password type="text" placeholder="请输入原密码" placeholder-class="field-placeholder" value="{{oldPassword}}" bindinput="onOldInput" />
      </view>
    </view>
    <view class="form-group">
      <view class="field-label">新密码</view>
      <view class="field-input-wrap">
        <input class="field-input" password type="text" placeholder="{{newPasswordPlaceholder}}" placeholder-class="field-placeholder" value="{{newPassword}}" bindinput="onNewInput" />
      </view>
    </view>
    <view class="form-group">
      <view class="field-label">确认新密码</view>
      <view class="field-input-wrap">
        <input class="field-input" password type="text" placeholder="再次输入新密码" placeholder-class="field-placeholder" value="{{confirmPassword}}" bindinput="onConfirmInput" />
      </view>
    </view>
    <view class="form-hint">正式环境将对接平台账号密码接口</view>
  </view>
  <button class="btn-primary submit-btn" loading="{{submitting}}" bindtap="submit">确认修改</button>
</view>
