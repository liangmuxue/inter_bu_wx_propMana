.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx;
  background: linear-gradient(180deg, #1A5FDB 0%, #F5F7FA 45%);
}
.login-logo {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
}
.login-desc {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 64rpx;
}
.login-card {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx 32rpx;
  box-sizing: border-box;
}
.form-group {
  margin-bottom: 28rpx;
}
.field-label {
  font-size: 26rpx;
  color: #4A5568;
  margin-bottom: 12rpx;
}
.field-input {
  height: 80rpx;
  padding: 0 24rpx;
  background: #F7FAFC;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.field-placeholder {
  color: #A0AEC0;
}
.login-btn {
  width: 100%;
  margin-top: 12rpx;
}
.login-hint {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #718096;
}
